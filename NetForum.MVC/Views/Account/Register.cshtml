@model NetForum.MVC.Models.RegisterViewModel

@{
    ViewData["Title"] = "Crear Cuenta";
    Layout = "_Layout";
}

<div class="auth-stadium-page"
     style="background-image: linear-gradient(rgba(0,0,0,.65), rgba(0,0,0,.85)), url('/images/stadium-bg.jpg') !important;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
    min-height: 100vh !important;">

    <div class="auth-overlay"></div>

    <div class="container auth-container">
        <div class="row justify-content-center align-items-center min-vh-100">

            <div class="col-lg-6 d-none d-lg-block">
                <div class="auth-info-panel">
                    <h1 class="display-5 fw-bold text-white mb-3">
                        Únete a la comunidad futbolera
                    </h1>

                    <p class="lead text-light mb-4">
                        Crea tu cuenta, participa en debates, comenta temas y comparte tu opinión sobre el mundo del fútbol.
                    </p>

                    <div class="row g-3">
                        <div class="col-4">
                            <div class="stat-card">
                                <h3>⚽</h3>
                                <span>Debates</span>
                            </div>
                        </div>

                        <div class="col-4">
                            <div class="stat-card">
                                <h3>Copa Mundial</h3>
                                <span>FIFA</span>
                            </div>
                        </div>

                        <div class="col-4">
                            <div class="stat-card">
                                <h3>Champions League</h3>
                                <span>UEFA</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5 col-md-8 col-sm-11">
                <div class="auth-glass-card">

                    <div class="text-center mb-4">
                        <div class="auth-ball-icon">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>

                        <h2 class="fw-bold text-white mt-3 mb-1">
                            Crear Cuenta
                        </h2>

                        <p class="text-light opacity-75">
                            Regístrate para comenzar a participar
                        </p>
                    </div>

                    <form asp-controller="Account" asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="mb-3">
                            <label asp-for="NombreUsuario" class="form-label text-light fw-semibold">
                                Nombre de usuario
                            </label>

                            <div class="input-group auth-input-group">
                                <span class="input-group-text">
                                    <i class="fa-solid fa-user"></i>
                                </span>

                                <input asp-for="NombreUsuario"
                                       class="form-control"
                                       placeholder="Ej: FutboleroCR"
                                       autocomplete="username" />
                            </div>

                            <span asp-validation-for="NombreUsuario" class="text-warning small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-light fw-semibold">
                                Correo electrónico
                            </label>

                            <div class="input-group auth-input-group">
                                <span class="input-group-text">
                                    <i class="fa-solid fa-envelope"></i>
                                </span>

                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="correo@ejemplo.com"
                                       autocomplete="email" />
                            </div>

                            <span asp-validation-for="Email" class="text-warning small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label text-light fw-semibold">
                                Contraseña
                            </label>

                            <div class="input-group auth-input-group">
                                <span class="input-group-text">
                                    <i class="fa-solid fa-lock"></i>
                                </span>

                                <input asp-for="Password"
                                       id="registerPasswordInput"
                                       type="password"
                                       class="form-control"
                                       placeholder="Mínimo 6 caracteres"
                                       autocomplete="new-password" />

                                <button class="btn btn-auth-eye" type="button" id="toggleRegisterPassword">
                                    <i id="registerEyeIcon" class="fa-solid fa-eye"></i>
                                </button>
                            </div>

                            <span asp-validation-for="Password" class="text-warning small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label text-light fw-semibold">
                                Confirmar contraseña
                            </label>

                            <div class="input-group auth-input-group">
                                <span class="input-group-text">
                                    <i class="fa-solid fa-shield-halved"></i>
                                </span>

                                <input asp-for="ConfirmPassword"
                                       id="confirmPasswordInput"
                                       type="password"
                                       class="form-control"
                                       placeholder="Repite tu contraseña"
                                       autocomplete="new-password" />

                                <button class="btn btn-auth-eye" type="button" id="toggleConfirmPassword">
                                    <i id="confirmEyeIcon" class="fa-solid fa-eye"></i>
                                </button>
                            </div>

                            <span asp-validation-for="ConfirmPassword" class="text-warning small"></span>
                        </div>

                        <button type="submit" class="btn btn-football w-100 fw-bold py-2">
                            <i class="fa-solid fa-user-plus me-2"></i>
                            Crear Cuenta
                        </button>

                        <div class="text-center mt-4">
                            <span class="text-light opacity-75">
                                ¿Ya tienes cuenta?
                            </span>

                            <a asp-controller="Account"
                               asp-action="Login"
                               class="text-warning fw-bold text-decoration-none ms-1">
                                Iniciar sesión
                            </a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function setupPasswordToggle(inputId, buttonId, iconId) {
            const input = document.getElementById(inputId);
            const button = document.getElementById(buttonId);
            const icon = document.getElementById(iconId);

            if (!input || !button || !icon) {
                return;
            }

            button.addEventListener("click", () => {
                const isPassword = input.type === "password";
                input.type = isPassword ? "text" : "password";

                icon.classList.toggle("fa-eye");
                icon.classList.toggle("fa-eye-slash");
            });
        }

        setupPasswordToggle("registerPasswordInput", "toggleRegisterPassword", "registerEyeIcon");
        setupPasswordToggle("confirmPasswordInput", "toggleConfirmPassword", "confirmEyeIcon");
    </script>
}