@model IEnumerable<NetForum.Data.Entities.Categoria>

@{
    ViewData["Title"] = "Gestión de Categorías";
}
@if (TempData["Success"] is not null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
        <div id="successToast" class="toast align-items-center text-bg-success border-0 shadow-lg" role="alert">
            <div class="d-flex">
                <div class="toast-body fw-semibold">
                    <i class="fa-solid fa-circle-check me-2"></i>
                    @TempData["Success"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white">
                <i class="fa-solid fa-layer-group text-success me-2"></i>
                Gestión de Categorías
            </h2>
            <p class="text-secondary mb-0">
                Administra las categorías del foro.
            </p>
        </div>
        <a asp-action="Create" class="btn btn-football px-4">
            <i class="fa-solid fa-plus me-2"></i>
            Nueva Categoría
        </a>
    </div>

    <div class="dashboard-panel">
        <div class="table-responsive">
            <table id="categoriasTable" class="table table-dark table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th style="width:170px;" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-secondary py-5">
                                <i class="fa-solid fa-folder-open fa-3x mb-3"></i>
                                <br />
                                No existen categorías registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CategoriaId</td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td>@item.Descripcion</td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.CategoriaId" class="btn btn-warning btn-sm">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    <form asp-action="DeleteConfirmed" asp-route-id="@item.CategoriaId" method="post" class="d-inline delete-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" data-nombre="@item.Nombre">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
          @*Scripts section for SweetAlert2 confirmation and DataTables initialization*@
@section Scripts {
    <script>
        document.querySelectorAll(".delete-form").forEach(form => {
            form.addEventListener("submit", function (e) {
                e.preventDefault();

                const nombre = this.querySelector("button").dataset.nombre;

                Swal.fire({
                    title: "¿Eliminar categoría?",
                    text: `Se eliminará "${nombre}". Esta acción no se puede deshacer.`,
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#dc3545",
                    cancelButtonColor: "#6c757d",
                    confirmButtonText: "Sí, eliminar",
                    cancelButtonText: "Cancelar",
                    background: "#16161D",
                    color: "#E4E4E7"
                }).then((result) => {
                    if (result.isConfirmed) {
                        this.submit();
                    }
                });
            });
        });
    </script>
                                 @*TOAST*@     
    <script>
    const successToast = document.getElementById("successToast");

    if (successToast) {
        const toast = new bootstrap.Toast(successToast, {
            delay: 3500
        });

        toast.show();
    }
</script>
        @*Inicializar DataTables*@
<script>
    $(document).ready(function () {
        $('#categoriasTable').DataTable({
            language: {
                url: "https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json"
            },
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50],
            order: [[1, "asc"]],
            columnDefs: [
                { orderable: false, targets: 3 }
            ],
            layout: {
                topStart: {
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="fa-solid fa-file-excel me-1"></i> Excel',
                            className: 'btn btn-success btn-sm'
                        },
                        {
                            extend: 'pdfHtml5',
                            text: '<i class="fa-solid fa-file-pdf me-1"></i> PDF',
                            className: 'btn btn-danger btn-sm'
                        },
                        {
                            extend: 'print',
                            text: '<i class="fa-solid fa-print me-1"></i> Imprimir',
                            className: 'btn btn-secondary btn-sm'
                        }
                    ]
                }
            }
        });
    });
</script>
}