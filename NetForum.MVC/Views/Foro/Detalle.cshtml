@model NetForum.MVC.Models.ForoDetalleViewModel

@{
    ViewData["Title"] = Model.Titulo;
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-controller="Foro"
           asp-action="Index"
           class="btn btn-outline-light btn-sm">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Volver al foro
        </a>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <span class="badge bg-success text-dark px-3 py-2">
            <i class="fa-solid fa-folder-open me-1"></i>
            @Model.Categoria
        </span>

        <span class="badge bg-dark border border-secondary text-light px-3 py-2">
            @Model.Estado
        </span>

        <button type="button"
                class="btn btn-outline-danger btn-sm"
                data-bs-toggle="modal"
                data-bs-target="#reporteModal">
            <i class="fa-solid fa-flag me-1"></i>
            Reportar
        </button>
    </div>

    <article class="dashboard-panel mb-4">

        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-success text-dark px-3 py-2">
                    <i class="fa-solid fa-folder-open me-1"></i>
                    @Model.Categoria
                </span>

                <span class="badge bg-dark border border-secondary text-light px-3 py-2">
                    @Model.Estado
                </span>
            </div>

            <span class="text-secondary small">
                <i class="fa-regular fa-clock me-1"></i>
                @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
            </span>
        </div>

        <h1 class="text-white fw-bold mb-4">
            @Model.Titulo
        </h1>

        <div class="d-flex align-items-center gap-3 mb-4 pb-4 border-bottom border-secondary">
            <div class="foro-avatar">
                <i class="fa-solid fa-user"></i>
            </div>

            <div>
                <div class="text-secondary small">
                    Publicado por
                </div>

                <div class="text-white fw-semibold">
                    @Model.Autor
                </div>
            </div>
        </div>

        <div class="foro-contenido text-light mb-4">
            @Model.Contenido
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pt-3 border-top border-secondary">
            <div class="text-secondary">
                <i class="fa-regular fa-comment me-1"></i>
                @Model.Respuestas.Count()
                @(Model.Respuestas.Count() == 1 ? "respuesta" : "respuestas")
            </div>

            <div class="text-secondary">
                <i class="fa-regular fa-heart me-1"></i>
                @Model.CantidadReacciones
                @(Model.CantidadReacciones == 1 ? "reacción" : "reacciones")
            </div>
        </div>
    </article>

    <section class="mb-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-white fw-bold mb-0">
                <i class="fa-solid fa-comments text-success me-2"></i>
                Respuestas
            </h2>

            <span class="badge bg-dark border border-secondary px-3 py-2">
                @Model.Respuestas.Count()
            </span>
        </div>

        @if (!Model.Respuestas.Any())
        {
            <div class="dashboard-panel text-center py-5">
                <i class="fa-regular fa-comment-dots fa-3x text-secondary mb-3"></i>

                <h4 class="text-white fw-bold">
                    Todavía no hay respuestas
                </h4>

                <p class="text-secondary mb-0">
                    Sé el primero en participar en esta conversación.
                </p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var respuesta in Model.Respuestas)
                {
                    <article class="dashboard-panel foro-respuesta">

                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                            <div class="d-flex align-items-center gap-3">

                                <div class="foro-avatar foro-avatar-small">
                                    <i class="fa-solid fa-user"></i>
                                </div>

                                <div>
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <span class="text-white fw-semibold">
                                            @respuesta.Autor
                                        </span>

                                        @if (respuesta.EsAutorTema)
                                        {
                                            <span class="badge bg-success text-dark">
                                                Autor
                                            </span>
                                        }
                                    </div>

                                    <span class="text-secondary small">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        @respuesta.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>
                            </div>

                            <span class="badge bg-dark border border-secondary">
                                @respuesta.Estado
                            </span>
                        </div>

                        <div class="foro-contenido text-light">
                            @respuesta.Contenido
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="dashboard-panel">
        <div class="mb-4">
            <h3 class="h5 text-white fw-bold mb-1">
                <i class="fa-solid fa-reply text-success me-2"></i>
                Publicar una respuesta
            </h3>

            <p class="text-secondary mb-0">
                Comparte tu opinión y mantén una conversación respetuosa.
            </p>
        </div>

        <form id="respuestaForm">
            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="temaId"
                   name="TemaId"
                   value="@Model.TemaId" />

            <div class="mb-3">
                <label for="contenidoRespuesta"
                       class="form-label text-secondary fw-semibold">
                    Tu respuesta
                </label>

                <textarea id="contenidoRespuesta"
                          name="Contenido"
                          class="form-control bg-dark text-white border-secondary"
                          rows="6"
                          maxlength="3000"
                          placeholder="Escribe tu respuesta..."
                          required></textarea>

                <div class="d-flex justify-content-between mt-2">
                    <span id="contenidoRespuestaError"
                          class="text-warning small"></span>

                    <span id="contadorRespuesta"
                          class="text-secondary small">
                        0 / 3000
                    </span>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit"
                        id="btnPublicarRespuesta"
                        class="btn btn-football px-4">
                    <i class="fa-solid fa-paper-plane me-2"></i>
                    Publicar respuesta
                </button>
            </div>
        </form>
    </section>
</div>

@section Styles {
    <style>
        .foro-avatar {
            width: 48px;
            height: 48px;
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(25, 135, 84, 0.15);
            border: 1px solid rgba(25, 135, 84, 0.55);
            color: #20c997;
            font-size: 1.15rem;
        }

        .foro-avatar-small {
            width: 42px;
            height: 42px;
            font-size: 1rem;
        }

        .foro-contenido {
            line-height: 1.8;
            white-space: pre-line;
            overflow-wrap: anywhere;
        }

        .foro-respuesta {
            transition: border-color 0.2s ease, transform 0.2s ease;
        }

            .foro-respuesta:hover {
                border-color: rgba(25, 135, 84, 0.55);
                transform: translateY(-2px);
            }
    </style>

    }

<div class="modal fade"
     id="reporteModal"
     tabindex="-1"
     aria-labelledby="reporteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-social-card border border-social text-white"
             style="border-radius: 18px;">

            <div class="modal-header border-social">
                <h5 class="modal-title fw-bold"
                    id="reporteModalLabel">
                    <i class="fa-solid fa-flag text-danger me-2"></i>
                    Reportar tema
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <p class="text-secondary">
                    Describe claramente por qué consideras que este tema debe ser revisado.
                </p>

                <textarea id="motivoReporte"
                          class="form-control bg-dark text-white border-secondary"
                          rows="5"
                          maxlength="500"
                          placeholder="Escribe el motivo del reporte..."></textarea>

                <div class="d-flex justify-content-between mt-2">
                    <span id="motivoReporteError"
                          class="text-warning small"></span>

                    <span id="contadorReporte"
                          class="text-secondary small">
                        0 / 500
                    </span>
                </div>
            </div>

            <div class="modal-footer border-social">
                <button type="button"
                        class="btn btn-outline-light"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        id="btnEnviarReporte"
                        class="btn btn-danger"
                        onclick="enviarReporte()">
                    <i class="fa-solid fa-paper-plane me-2"></i>
                    Enviar reporte
                </button>
            </div>
        </div>
    </div>
</div>

    @section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const formulario =
                document.getElementById("respuestaForm");

            const contenido =
                document.getElementById("contenidoRespuesta");

            const contador =
                document.getElementById("contadorRespuesta");

            contenido.addEventListener("input", function () {
                contador.textContent =
                    `${contenido.value.length} / 3000`;

                document.getElementById(
                    "contenidoRespuestaError"
                ).innerText = "";
            });

            formulario.addEventListener(
                "submit",
                publicarRespuesta
            );
        });

        async function publicarRespuesta(event) {
            event.preventDefault();

            const contenido =
                document.getElementById(
                    "contenidoRespuesta"
                ).value.trim();

            const error =
                document.getElementById(
                    "contenidoRespuestaError"
                );

            const boton =
                document.getElementById(
                    "btnPublicarRespuesta"
                );

            error.innerText = "";

            if (contenido.length < 2) {
                error.innerText =
                    "La respuesta debe contener al menos 2 caracteres.";

                return;
            }

            if (contenido.length > 3000) {
                error.innerText =
                    "La respuesta no puede superar los 3000 caracteres.";

                return;
            }

            const formData = new FormData();

            formData.append(
                "__RequestVerificationToken",
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                ).value
            );

            formData.append(
                "TemaId",
                document.getElementById("temaId").value
            );

            formData.append("Contenido", contenido);

            boton.disabled = true;

            boton.innerHTML = `
                <span class="spinner-border spinner-border-sm me-2"></span>
                Publicando...
            `;

            try {
                const response = await fetch(
                    "/Foro/ResponderAjax",
                    {
                        method: "POST",
                        body: formData
                    }
                );

                const data =
                    await obtenerRespuestaJson(response);

                if (!response.ok) {
                    mostrarErrorRespuesta(
                        data.message ??
                        "No se pudo publicar la respuesta."
                    );

                    return;
                }

                await Swal.fire({
                    icon: "success",
                    title: "Respuesta publicada",
                    text: data.message,
                    timer: 1600,
                    showConfirmButton: false,
                    background: "#16161D",
                    color: "#E4E4E7"
                });

                location.reload();
            } catch {
                mostrarErrorRespuesta(
                    "Ocurrió un error al publicar la respuesta."
                );
            } finally {
                boton.disabled = false;

                boton.innerHTML = `
                    <i class="fa-solid fa-paper-plane me-2"></i>
                    Publicar respuesta
                `;
            }
        }

        async function obtenerRespuestaJson(response) {
            try {
                return await response.json();
            } catch {
                return {};
            }
        }

        function mostrarErrorRespuesta(mensaje) {
            Swal.fire({
                icon: "error",
                title: "No se pudo publicar",
                text: mensaje,
                background: "#16161D",
                color: "#E4E4E7"
            });
        }

                const motivoReporte =
            document.getElementById("motivoReporte");

        if (motivoReporte) {
            motivoReporte.addEventListener("input", function () {
                document.getElementById(
                    "contadorReporte"
                ).textContent =
                    `${motivoReporte.value.length} / 500`;

                document.getElementById(
                    "motivoReporteError"
                ).innerText = "";
            });
        }

        async function enviarReporte() {
            const motivo =
                document.getElementById(
                    "motivoReporte"
                ).value.trim();

            const error =
                document.getElementById(
                    "motivoReporteError"
                );

            const boton =
                document.getElementById(
                    "btnEnviarReporte"
                );

            error.innerText = "";

            if (motivo.length < 10) {
                error.innerText =
                    "El motivo debe contener al menos 10 caracteres.";

                return;
            }

            const formData = new FormData();

            formData.append(
                "__RequestVerificationToken",
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                ).value
            );

            formData.append("TemaId", "@Model.TemaId");
            formData.append("Motivo", motivo);

            boton.disabled = true;

            boton.innerHTML = `
                <span class="spinner-border spinner-border-sm me-2"></span>
                Enviando...
            `;

            try {
                const response = await fetch(
                    "/Foro/ReportarAjax",
                    {
                        method: "POST",
                        body: formData
                    }
                );

                const data =
                    await obtenerRespuestaJson(response);

                if (!response.ok) {
                    mostrarErrorRespuesta(
                        data.message ??
                        "No se pudo enviar el reporte."
                    );

                    return;
                }

                const modalElement =
                    document.getElementById("reporteModal");

                const modal =
                    bootstrap.Modal.getInstance(modalElement);

                modal?.hide();

                await Swal.fire({
                    icon: "success",
                    title: "Reporte enviado",
                    text: data.message,
                    timer: 1700,
                    showConfirmButton: false,
                    background: "#16161D",
                    color: "#E4E4E7"
                });

                motivoReporte.value = "";

                document.getElementById(
                    "contadorReporte"
                ).textContent = "0 / 500";
            } catch {
                mostrarErrorRespuesta(
                    "Ocurrió un error al enviar el reporte."
                );
            } finally {
                boton.disabled = false;

                boton.innerHTML = `
                    <i class="fa-solid fa-paper-plane me-2"></i>
                    Enviar reporte
                `;
            }
        }
    </script>
}


}