@model NetForum.MVC.Models.ForoIndexViewModel

@{
    ViewData["Title"] = "Foro";
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold text-white mb-1">
                <i class="fa-solid fa-comments text-success me-2"></i>
                Comunidad NetForum
            </h1>

            <p class="text-secondary mb-0">
                Explora los temas más recientes y participa en la conversación.
            </p>
        </div>

        <a asp-controller="Foro"
           asp-action="Crear"
           class="btn btn-football px-4">
            <i class="fa-solid fa-plus me-2"></i>
            Publicar tema
        </a>
    </div>

    <div class="dashboard-panel mb-4">
        <form asp-controller="Foro"
              asp-action="Index"
              method="get"
              class="row g-3 align-items-end">

            <div class="col-lg-6">
                <label for="buscar"
                       class="form-label text-secondary fw-semibold">
                    Buscar
                </label>

                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-secondary">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>

                    <input type="text"
                           id="buscar"
                           name="buscar"
                           value="@Model.Buscar"
                           class="form-control bg-dark text-white border-secondary"
                           placeholder="Buscar por título o contenido..." />
                </div>
            </div>

            <div class="col-lg-4">
                <label for="categoriaId"
                       class="form-label text-secondary fw-semibold">
                    Categoría
                </label>

                <select id="categoriaId"
                        name="categoriaId"
                        class="form-select bg-dark text-white border-secondary">

                    <option value="">Todas las categorías</option>

                    @foreach (var categoria in Model.Categorias)
                    {
                        <option value="@categoria.Value"
                                selected="@categoria.Selected">
                            @categoria.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-lg-2 d-grid">
                <button type="submit"
                        class="btn btn-football">
                    <i class="fa-solid fa-filter me-2"></i>
                    Filtrar
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Buscar)
                || Model.CategoriaId.HasValue)
            {
                <div class="col-12">
                    <a asp-controller="Foro"
                       asp-action="Index"
                       class="btn btn-outline-light btn-sm">
                        <i class="fa-solid fa-xmark me-1"></i>
                        Limpiar filtros
                    </a>
                </div>
            }
        </form>
    </div>

    @if (!Model.Temas.Any())
    {
        <div class="dashboard-panel text-center py-5">
            <i class="fa-regular fa-comments fa-4x text-secondary mb-3"></i>

            <h4 class="text-white fw-bold">
                No se encontraron temas
            </h4>

            <p class="text-secondary mb-3">
                No existen publicaciones que coincidan con los filtros seleccionados.
            </p>

            <a asp-controller="Foro"
               asp-action="Index"
               class="btn btn-outline-light">
                Ver todos los temas
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var tema in Model.Temas)
            {
                <div class="col-12">
                    <article class="dashboard-panel foro-topic-card">

                        <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="badge bg-success text-dark px-3 py-2">
                                    <i class="fa-solid fa-folder-open me-1"></i>
                                    @tema.Categoria
                                </span>

                                <span class="badge bg-dark border border-secondary text-light px-3 py-2">
                                    @tema.Estado
                                </span>
                            </div>

                            <span class="text-secondary small">  
                                <i class="fa-regular fa-clock me-1"></i>
                                @tema.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>

                        <h3 class="h4 fw-bold mb-3">
                            <a asp-controller="Foro"
                               asp-action="Detalle"
                               asp-route-id="@tema.TemaId"
                               class="text-white text-decoration-none foro-topic-title">
                                @tema.Titulo
                            </a>
                        </h3>

                        <p class="text-secondary mb-4 foro-topic-summary">
                            @tema.ContenidoResumen
                        </p>

                        @if (tema.Etiquetas.Any())  // este condicional verifica si hay etiquetas para mostrar
                        {
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                @foreach (var etiqueta in tema.Etiquetas)
                                {
                                    <span class="foro-tag">
                                        <i class="fa-solid fa-tag me-1"></i>
                                        #@etiqueta.Nombre
                                    </span>
                                }
                            </div>
                        }

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div class="text-secondary">
                                <i class="fa-solid fa-user-circle me-1"></i>
                                Publicado por
                                <span class="text-white fw-semibold">
                                    @tema.Autor
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-3">
                                <span class="text-secondary">
                                    <i class="fa-regular fa-comment me-1"></i>
                                    @tema.CantidadRespuestas
                                </span>

                                <span class="text-secondary">
                                    <i class="fa-regular fa-heart me-1"></i>
                                    @tema.CantidadReacciones
                                </span>

                                <a asp-controller="Foro"
                                   asp-action="Detalle"
                                   asp-route-id="@tema.TemaId"
                                   class="btn btn-outline-success btn-sm">
                                    Ver conversación
                                    <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        .foro-topic-card {
            transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .foro-topic-card:hover {
                transform: translateY(-3px);
                border-color: rgba(25, 135, 84, 0.7);
                box-shadow: 0 14px 35px rgba(0, 0, 0, 0.28);
            }

        .foro-topic-title {
            transition: color 0.2s ease;
        }

            .foro-topic-title:hover {
                color: #20c997 !important;
            }

        .foro-topic-summary {
            line-height: 1.7;
        }

        .foro-tag {
            display: inline-flex;
            align-items: center;
            padding: .4rem .75rem;
            border-radius: 50rem;
            background: rgba(25, 135, 84, .12);
            border: 1px solid rgba(25, 135, 84, .35);
            color: #75d6a0;
            font-size: .82rem;
            font-weight: 600;
        }
    </style>
}