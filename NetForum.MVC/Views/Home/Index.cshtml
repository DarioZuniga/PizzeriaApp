@model NetForum.MVC.Models.DashboardViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
    var nombreUsuario = Model.NombreUsuario;
}

<div class="container-fluid px-4 py-4">

    <!-- HERO SECTION -->
    <section class="football-hero mb-4">
        <div class="football-hero-content">
            <span class="badge bg-success-subtle text-success border border-success mb-3">
                ⚽ NetForum Football Community
            </span>

            <h1 class="display-5 fw-bold text-white mb-3">
                Bienvenido, @nombreUsuario
            </h1>

            <p class="lead text-light opacity-75 mb-4">
                Debate partidos, fichajes, polémicas, jugadores, ligas y todo lo que mueve al mundo del fútbol.
            </p>

            <a asp-controller="Foro"
               asp-action="Index"
               class="btn btn-football px-4 py-2 fw-bold">
                <i class="fa-solid fa-fire me-2"></i>
                Explorar Temas
            </a>

            <a asp-controller="Foro"
               asp-action="Crear"
               class="btn btn-outline-light px-4 py-2 fw-bold">
                <i class="fa-solid fa-plus me-2"></i>
                Crear Tema
            </a>
        </div>
    </section>

    <!-- METRICS CARDS -->
    <section class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-stat-card">
                <i class="fa-solid fa-users"></i>
                <div>
                    <h3>@Model.TotalUsuarios</h3>
                    <span>Usuarios</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-stat-card">
                <i class="fa-solid fa-comments"></i>
                <div>
                    <h3>@Model.TotalTemas</h3>
                    <span>Temas</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-stat-card">
                <i class="fa-solid fa-futbol"></i>
                <div>
                    <h3>@Model.TotalEquipos</h3>
                    <span>Equipos</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-stat-card">
                <i class="fa-solid fa-trophy"></i>
                <div>
                    <h3>@Model.TotalLigas</h3>
                    <span>Ligas</span>
                </div>
            </div>
        </div>
    </section>

    <!-- MAIN CONTENT ROW -->
    <section class="row g-4">

        <!-- COLUMNA IZQUIERDA -->
        <div class="col-lg-8">
            
            <!-- Temas Destacados -->
            <div class="dashboard-panel mb-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold text-white mb-1">
                            🔥 Temas destacados
                        </h4>
                        <p class="text-secondary mb-0">
                            Conversaciones activas de la comunidad
                        </p>
                    </div>

                    <span class="badge bg-dark border border-social text-success">
                        En vivo
                    </span>
                </div>

                @if (!Model.TemasDestacados.Any())
                {
                    <div class="text-center py-5">
                        <i class="fa-regular fa-comments fa-3x text-secondary mb-3"></i>

                        <h5 class="text-white fw-bold">
                            Aún no hay temas destacados
                        </h5>

                        <p class="text-secondary mb-0">
                            Las conversaciones más activas aparecerán aquí.
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var tema in Model.TemasDestacados)
                    {
                        <a asp-controller="Foro"
                           asp-action="Detalle"
                           asp-route-id="@tema.TemaId"
                           class="topic-card text-decoration-none">

                            <div class="topic-avatar bg-success">
                                @tema.Iniciales
                            </div>

                            <div class="flex-grow-1">

                                <h5 class="text-white fw-bold mb-1">
                                    @tema.Titulo
                                </h5>

                                <p class="text-secondary mb-2">
                                    @tema.Resumen
                                </p>

                                <div class="d-flex flex-wrap gap-3 small text-secondary">

                                    <span>
                                        <i class="fa-solid fa-comment me-1"></i>
                                        @tema.CantidadRespuestas respuestas
                                    </span>

                                    <span>
                                        <i class="fa-solid fa-heart me-1"></i>
                                        @tema.CantidadReacciones reacciones
                                    </span>

                                    <span>
                                        <i class="fa-solid fa-clock me-1"></i>
                                        @tema.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                    </span>

                                </div>

                            </div>

                        </a>
                    }
                }

            </div>

            <!-- Gráfico: Temas por categoría -->
            <div class="dashboard-panel">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold text-white mb-1">
                            <i class="fa-solid fa-chart-column text-success me-2"></i>
                            Temas por categoría
                        </h4>

                        <p class="text-secondary mb-0">
                            Distribución de publicaciones de la comunidad
                        </p>
                    </div>
                </div>

                @if (!Model.TemasPorCategoria.Any())
                {
                    <div class="text-center text-secondary py-5">
                        No existen datos suficientes para mostrar la gráfica.
                    </div>
                }
                else
                {
                    <div style="position: relative; height: 350px;">
                        <canvas id="temasCategoriaChart"></canvas>
                    </div>
                }
            </div>

        </div>

        <!-- COLUMNA DERECHA -->
        <div class="col-lg-4">
            <div class="dashboard-panel mb-4">
                <h5 class="fw-bold text-white mb-3">
                    🏆 Ligas populares
                </h5>

                <div class="league-pill">Premier League</div>
                <div class="league-pill">La Liga</div>
                <div class="league-pill">Champions League</div>
                <div class="league-pill">Liga Promerica</div>
            </div>

            <div class="dashboard-panel">
                <h5 class="fw-bold text-white mb-3">
                    ⚡ Actividad reciente
                </h5>

                <div class="activity-item">
                    <span>Nuevo usuario registrado</span>
                    <small>Hace 5 min</small>
                </div>

                <div class="activity-item">
                    <span>Nuevo tema en Champions</span>
                    <small>Hace 12 min</small>
                </div>

                <div class="activity-item">
                    <span>Reporte enviado a moderación</span>
                    <small>Hace 30 min</small>
                </div>
            </div>
        </div>

    </section>

    <!-- PRÓXIMOS PARTIDOS (ANCHO COMPLETO) -->
    <div class="dashboard-panel mt-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold text-white mb-1">
                    <i class="fa-solid fa-futbol text-success me-2"></i>
                    Próximos partidos
                </h4>

                <p class="text-secondary mb-0">
                    Calendario futbolístico actualizado
                </p>
            </div>

            <span class="badge bg-dark border border-social text-success">
                Football Data
            </span>
        </div>

        @if (!Model.ProximosPartidos.Any())
        {
            <div class="text-center py-4 text-secondary">
                No hay próximos partidos disponibles.
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">

                @foreach (var partido in Model.ProximosPartidos)
                {
                    <div class="match-card">

                        <div class="text-secondary small mb-2">
                            @partido.Competicion
                        </div>

                        <div class="row align-items-center">

                            <div class="col text-end">
                                @if (!string.IsNullOrWhiteSpace(partido.EscudoLocal))
                                {
                                    <img src="@partido.EscudoLocal"
                                         alt="@partido.Local"
                                         width="32"
                                         height="32"
                                         class="me-2" />
                                }

                                <span class="text-white fw-semibold">
                                    @partido.Local
                                </span>
                            </div>

                            <div class="col-auto text-center">
                                <div class="fw-bold text-success">
                                    VS
                                </div>

                                @(partido.FechaUtc
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy HH:mm"))
                            </div>

                            <div class="col">
                                @if (!string.IsNullOrWhiteSpace(partido.EscudoVisitante))
                                {
                                    <img src="@partido.EscudoVisitante"
                                         alt="@partido.Visitante"
                                         width="32"
                                         height="32"
                                         class="me-2" />
                                }

                                <span class="text-white fw-semibold">
                                    @partido.Visitante
                                </span>
                            </div>

                            <div class="mt-3 text-center">
                                <a asp-controller="Foro"
                                   asp-action="Crear"
                                   asp-route-titulo="@($"Debate: {partido.Local} vs {partido.Visitante}")"
                                   asp-route-contenido="@(
                                       $"¿Qué opinas sobre el partido {partido.Local} vs {partido.Visitante} " +
                                       $"de {partido.Competicion}? " +
                                       $"El encuentro está programado para el " +
                                       $"{partido.FechaUtc.ToLocalTime():dd/MM/yyyy HH:mm}. " +
                                       $"Comparte tu análisis, pronóstico y opinión sobre este encuentro."
                                   )"
                                   class="btn btn-outline-success btn-sm">
                                    <i class="fa-solid fa-comments me-1"></i>
                                    Debatir partido
                                </a>
                            </div>

                        </div>

                    </div>
                }

            </div>
        }

        <div class="text-secondary small mt-4">
            Data provided by football-data.org
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @if (Model.TemasPorCategoria.Any())
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // Serializar datos enviando las etiquetas y los valores desde el modelo
                const labels = @Html.Raw(Json.Serialize(Model.TemasPorCategoria.Select(x => x.Categoria)));
                const dataValues = @Html.Raw(Json.Serialize(Model.TemasPorCategoria.Select(x => x.Cantidad)));

                const ctx = document.getElementById('temasCategoriaChart').getContext('2d');
                new Chart(ctx, {
                    type: 'bar', // Puedes cambiarlo a 'doughnut' o 'pie'
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Cantidad de Temas',
                            data: dataValues,
                            backgroundColor: '#198754',
                            borderColor: '#20c997',
                            borderWidth: 1,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { color: '#a0a0a0', stepSize: 1 },
                                grid: { color: 'rgba(255, 255, 255, 0.05)' }
                            },
                            x: {
                                ticks: { color: '#a0a0a0' },
                                grid: { display: false }
                            }
                        }
                    }
                });
            });
        </script>

        <script>
    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const canvas =
                document.getElementById(
                    "temasCategoriaChart"
                );

            if (!canvas) {
                return;
            }

            const categorias =
                @Html.Raw(
                    JsonSerializer.Serialize(
                        Model.TemasPorCategoria
                            .Select(x => x.Categoria)
                    )
                );

            const cantidades =
                @Html.Raw(
                    JsonSerializer.Serialize(
                        Model.TemasPorCategoria
                            .Select(x => x.Cantidad)
                    )
                );

            new Chart(
                canvas,
                {
                    type: "bar",

                    data: {
                        labels: categorias,

                        datasets: [
                            {
                                label: "Temas",
                                data: cantidades,
                                borderWidth: 1
                            }
                        ]
                    },

                    options: {
                        responsive: true,
                        maintainAspectRatio: false,

                        plugins: {
                            legend: {
                                labels: {
                                    color: "#E4E4E7"
                                }
                            }
                        },

                        scales: {
                            x: {
                                ticks: {
                                    color: "#A1A1AA"
                                },

                                grid: {
                                    color:
                                        "rgba(255,255,255,0.05)"
                                }
                            },

                            y: {
                                beginAtZero: true,

                                ticks: {
                                    color: "#A1A1AA",
                                    precision: 0
                                },

                                grid: {
                                    color:
                                        "rgba(255,255,255,0.05)"
                                }
                            }
                        }
                    }
                }
            );
        }
    );
</script>
    }
}