@model NetForum.MVC.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var nombreUsuario = Model.NombreUsuario;
}

<div class="container-fluid px-4 py-4">

    <section class="football-hero mb-4">
        <div class="football-hero-content">
            <span class="badge bg-success-subtle text-success border border-success mb-3">
                ⚽ NetForum Football Community
            </span>

            <h1 class="display-5 fw-bold text-white mb-3">
                Bienvenido, @nombreUsuario
            </h1>

            <p class="lead text-light opacity-75 mb-4">
                Debate partidos, fichajes, polémicas, jugadores, ligas y todo lo que mueve al mundo del fútbol.
            </p>

            <div class="d-flex flex-wrap gap-3">
                <a class="btn btn-football px-4 py-2 fw-bold" href="#">
                    <i class="fa-solid fa-fire me-2"></i>
                    Explorar Temas
                </a>

                <a class="btn btn-outline-light px-4 py-2 fw-bold" href="#">
                    <i class="fa-solid fa-plus me-2"></i>
                    Crear Tema
                </a>
            </div>
        </div>
    </section>

    <section class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-stat-card">
                <i class="fa-solid fa-users"></i>
                <div>
                    <h3>@Model.TotalUsuarios</h3>  @*Con este código el dashboard muestra datos reales desde SQL Server*@
                    <span>Usuarios</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-stat-card">
                <i class="fa-solid fa-comments"></i>
                <div>
                    <h3>@Model.TotalTemas</h3>  @*Con este código el dashboard muestra datos reales desde SQL Server*@
                    <span>Temas</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-stat-card">
                <i class="fa-solid fa-futbol"></i>
                <div>
                    <h3>@Model.TotalEquipos</h3>  @*Con este código el dashboard muestra datos reales desde SQL Server*@
                    <span>Equipos</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-stat-card">
                <i class="fa-solid fa-trophy"></i>
                <div>
                    <h3>@Model.TotalLigas</h3>  @*Con este código el dashboard muestra datos reales desde SQL Server*@
                    <span>Ligas</span>
                </div>
            </div>
        </div>
    </section>

    <section class="row g-4">

        <div class="col-lg-8">
            <div class="dashboard-panel">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold text-white mb-1">
                            🔥 Temas destacados
                        </h4>
                        <p class="text-secondary mb-0">
                            Conversaciones activas de la comunidad
                        </p>
                    </div>

                    <span class="badge bg-dark border border-social text-success">
                        En vivo
                    </span>
                </div>

                <div class="topic-card">
                    <div class="topic-avatar bg-success">
                        RM
                    </div>

                    <div class="flex-grow-1">
                        <h5 class="text-white fw-bold mb-1">
                            ¿Real Madrid es favorito para ganar la Champions?
                        </h5>
                        <p class="text-secondary mb-2">
                            Debate sobre plantilla, calendario, fichajes y rendimiento europeo.
                        </p>

                        <div class="d-flex gap-3 small text-secondary">
                            <span><i class="fa-solid fa-comment me-1"></i> 32 respuestas</span>
                            <span><i class="fa-solid fa-heart me-1"></i> 88 reacciones</span>
                            <span><i class="fa-solid fa-clock me-1"></i> Hace 18 min</span>
                        </div>
                    </div>
                </div>

                <div class="topic-card">
                    <div class="topic-avatar bg-warning text-dark">
                        VAR
                    </div>

                    <div class="flex-grow-1">
                        <h5 class="text-white fw-bold mb-1">
                            ¿El VAR está mejorando o arruinando el fútbol?
                        </h5>
                        <p class="text-secondary mb-2">
                            Una discusión caliente sobre arbitraje, justicia deportiva y emoción.
                        </p>

                        <div class="d-flex gap-3 small text-secondary">
                            <span><i class="fa-solid fa-comment me-1"></i> 47 respuestas</span>
                            <span><i class="fa-solid fa-heart me-1"></i> 120 reacciones</span>
                            <span><i class="fa-solid fa-clock me-1"></i> Hace 45 min</span>
                        </div>
                    </div>
                </div>

                <div class="topic-card">
                    <div class="topic-avatar bg-primary">
                        CR
                    </div>

                    <div class="flex-grow-1">
                        <h5 class="text-white fw-bold mb-1">
                            Liga Promerica: ¿quién llega más fuerte a semifinales?
                        </h5>
                        <p class="text-secondary mb-2">
                            Opiniones sobre Saprissa, Alajuelense, Herediano y Cartaginés.
                        </p>

                        <div class="d-flex gap-3 small text-secondary">
                            <span><i class="fa-solid fa-comment me-1"></i> 21 respuestas</span>
                            <span><i class="fa-solid fa-heart me-1"></i> 54 reacciones</span>
                            <span><i class="fa-solid fa-clock me-1"></i> Hace 1 hora</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-lg-4">
            <div class="dashboard-panel mb-4">
                <h5 class="fw-bold text-white mb-3">
                    🏆 Ligas populares
                </h5>

                <div class="league-pill">Premier League</div>
                <div class="league-pill">La Liga</div>
                <div class="league-pill">Champions League</div>
                <div class="league-pill">Liga Promerica</div>
            </div>

            <div class="dashboard-panel">
                <h5 class="fw-bold text-white mb-3">
                    ⚡ Actividad reciente
                </h5>

                <div class="activity-item">
                    <span>Nuevo usuario registrado</span>
                    <small>Hace 5 min</small>
                </div>

                <div class="activity-item">
                    <span>Nuevo tema en Champions</span>
                    <small>Hace 12 min</small>
                </div>

                <div class="activity-item">
                    <span>Reporte enviado a moderación</span>
                    <small>Hace 30 min</small>
                </div>
            </div>
        </div>

    </section>
</div>