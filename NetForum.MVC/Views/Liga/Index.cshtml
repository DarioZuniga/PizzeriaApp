@model IEnumerable<NetForum.Data.Entities.Liga>

@{
    ViewData["Title"] = "Gestión de Ligas";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white">
                <i class="fa-solid fa-trophy text-success me-2"></i>
                Gestión de Ligas
            </h2>
            <p class="text-secondary mb-0">
                Administra ligas y competiciones desde una sola pantalla.
            </p>
        </div>

        <button class="btn btn-football px-4" data-bs-toggle="modal" data-bs-target="#ligaModal" onclick="abrirCrearLiga()">
            <i class="fa-solid fa-plus me-2"></i>
            Nueva Liga
        </button>
    </div>

    <div class="dashboard-panel">
        <div class="table-responsive">
            <table id="ligasTable" class="table table-dark table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th>Nombre</th>
                        <th>País</th>
                        <th style="width:170px;" class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-id="@item.LigaId">
                            <td>@item.LigaId</td>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td>@item.Pais</td>
                            <td class="text-center">
                                <button class="btn btn-warning btn-sm" onclick="abrirEditarLiga(@item.LigaId)">
                                    <i class="fa-solid fa-pen"></i>
                                </button>

                                <button class="btn btn-danger btn-sm" onclick="eliminarLiga(@item.LigaId, '@item.Nombre')">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Crear / Editar -->
<div class="modal fade" id="ligaModal" tabindex="-1" aria-labelledby="ligaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-social-card border border-social text-white" style="border-radius: 18px;">
            <div class="modal-header border-social">
                <h5 class="modal-title fw-bold" id="ligaModalLabel">
                    Nueva Liga
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="ligaId" />

                <div class="mb-3">
                    <label class="form-label text-secondary fw-semibold">Nombre</label>
                    <input type="text" id="nombreLiga" class="form-control bg-dark text-white border-secondary" placeholder="Ej: Premier League" />
                    <span id="nombreLigaError" class="text-warning small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary fw-semibold">País</label>
                    <input type="text" id="paisLiga" class="form-control bg-dark text-white border-secondary" placeholder="Ej: Inglaterra" />
                    <span id="paisLigaError" class="text-warning small"></span>
                </div>
            </div>

            <div class="modal-footer border-social">
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button" class="btn btn-football" onclick="guardarLiga()">
                    <i class="fa-solid fa-save me-2"></i>
                    Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let ligasTable;

        $(document).ready(function () {
            ligasTable = $('#ligasTable').DataTable({
                language: {
                    url: "https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json"
                },
                pageLength: 5,
                lengthMenu: [5, 10, 25, 50],
                order: [[1, "asc"]],
                columnDefs: [
                    { orderable: false, targets: 3 }
                ],
                layout: {
                    topStart: {
                        buttons: [
                            {
                                extend: 'excelHtml5',
                                text: '<i class="fa-solid fa-file-excel me-1"></i> Excel',
                                className: 'btn btn-success btn-sm'
                            },
                            {
                                extend: 'pdfHtml5',
                                text: '<i class="fa-solid fa-file-pdf me-1"></i> PDF',
                                className: 'btn btn-danger btn-sm'
                            },
                            {
                                extend: 'print',
                                text: '<i class="fa-solid fa-print me-1"></i> Imprimir',
                                className: 'btn btn-secondary btn-sm'
                            }
                        ]
                    }
                }
            });
        });

        function obtenerToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        function limpiarFormulario() {
            document.getElementById("ligaId").value = "";
            document.getElementById("nombreLiga").value = "";
            document.getElementById("paisLiga").value = "";
            document.getElementById("nombreLigaError").innerText = "";
            document.getElementById("paisLigaError").innerText = "";
        }

        function abrirCrearLiga() {
            limpiarFormulario();
            document.getElementById("ligaModalLabel").innerText = "Nueva Liga";
        }

        async function abrirEditarLiga(id) {
            limpiarFormulario();

            const response = await fetch(`/Liga/GetById/${id}`);

            if (!response.ok) {
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: "No se pudo cargar la liga.",
                    background: "#16161D",
                    color: "#E4E4E7"
                });

                return;
            }

            const liga = await response.json();

            document.getElementById("ligaId").value = liga.ligaId;
            document.getElementById("nombreLiga").value = liga.nombre;
            document.getElementById("paisLiga").value = liga.pais;
            document.getElementById("ligaModalLabel").innerText = "Editar Liga";

            const modal = new bootstrap.Modal(document.getElementById("ligaModal"));
            modal.show();
        }

        async function guardarLiga() {
            const id = document.getElementById("ligaId").value;
            const nombre = document.getElementById("nombreLiga").value.trim();
            const pais = document.getElementById("paisLiga").value.trim();

            document.getElementById("nombreLigaError").innerText = "";
            document.getElementById("paisLigaError").innerText = "";

            let valido = true;

            if (!nombre) {
                document.getElementById("nombreLigaError").innerText = "El nombre es obligatorio.";
                valido = false;
            }

            if (!pais) {
                document.getElementById("paisLigaError").innerText = "El país es obligatorio.";
                valido = false;
            }

            if (!valido) {
                return;
            }

            const formData = new FormData();
            formData.append("__RequestVerificationToken", obtenerToken());
            formData.append("Nombre", nombre);
            formData.append("Pais", pais);

            const url = id
                ? `/Liga/EditAjax/${id}`
                : `/Liga/CreateAjax`;

            const response = await fetch(url, {
                method: "POST",
                body: formData
            });

            if (!response.ok) {
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: "No se pudo guardar la liga.",
                    background: "#16161D",
                    color: "#E4E4E7"
                });

                return;
            }

            const result = await response.json();

            if (result.success) {
                Swal.fire({
                    icon: "success",
                    title: "Correcto",
                    text: result.message,
                    timer: 1600,
                    showConfirmButton: false,
                    background: "#16161D",
                    color: "#E4E4E7"
                }).then(() => {
                    location.reload();
                });
            }
        }

        function eliminarLiga(id, nombre) {
            Swal.fire({
                title: "¿Eliminar liga?",
                text: `Se eliminará "${nombre}". Esta acción no se puede deshacer.`,
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#dc3545",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Sí, eliminar",
                cancelButtonText: "Cancelar",
                background: "#16161D",
                color: "#E4E4E7"
            }).then(async (result) => {
                if (!result.isConfirmed) {
                    return;
                }

                const formData = new FormData();
                formData.append("__RequestVerificationToken", obtenerToken());

                const response = await fetch(`/Liga/DeleteAjax/${id}`, {
                    method: "POST",
                    body: formData
                });

                if (!response.ok) {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: "No se pudo eliminar la liga.",
                        background: "#16161D",
                        color: "#E4E4E7"
                    });

                    return;
                }

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: "success",
                        title: "Eliminada",
                        text: data.message,
                        timer: 1500,
                        showConfirmButton: false,
                        background: "#16161D",
                        color: "#E4E4E7"
                    }).then(() => {
                        location.reload();
                    });
                }
            });
        }
    </script>
}