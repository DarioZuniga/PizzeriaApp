<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NetForum</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                background-color: #0F0F12 !important;
                color: #E4E4E7 !important;
                font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            }

            .bg-social-card {
                background-color: #16161D !important;
            }

            .border-social {
                border-color: #23232F !important;
            }

            .text-violet-neon {
                color: #A78BFA !important;
            }

            .btn-violet-neon {
                background-color: #8B5CF6 !important;
                color: #ffffff !important;
                border: none;
                transition: all 0.2s ease;
            }

                .btn-violet-neon:hover {
                    background-color: #7C3AED !important;
                    transform: translateY(-1px);
                }

            .btn-outline-neon {
                border: 1px solid #23232F !important;
                color: #E4E4E7 !important;
                transition: all 0.2s;
            }

                .btn-outline-neon:hover {
                    background-color: #23232F !important;
                    color: #ffffff !important;
                }

            .nav-social-link {
                color: #A1A1AA !important;
                font-weight: 500;
                text-decoration: none;
                transition: color 0.2s;
            }

                .nav-social-link:hover, .nav-social-link.active {
                    color: #8B5CF6 !important;
                }

            /* Estilo personalizado para el menú desplegable oscuro */
            .dropdown-menu-dark-custom {
                background-color: #16161D !important;
                border: 1px solid #23232F !important;
                border-radius: 12px;
                padding: 8px;
            }

                .dropdown-menu-dark-custom .dropdown-item {
                    color: #E4E4E7 !important;
                    border-radius: 6px;
                    transition: all 0.2s;
                }

                    .dropdown-menu-dark-custom .dropdown-item:hover {
                        background-color: #23232F !important;
                        color: #ffffff !important;
                    }
    </style>
</head>
<body class="d-flex flex-column" style="min-height: 100vh;">

    <nav class="navbar navbar-expand-md bg-social-card border-bottom border-social sticky-top py-2 px-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-white fs-3 d-flex align-items-center" asp-controller="Home" asp-action="Index" style="letter-spacing: -1px; text-decoration: none;">
                Net<span class="text-violet-neon">Forum</span>
            </a>

            <div class="collapse navbar-collapse d-flex justify-content-between">
                <div class="mx-auto d-none d-md-block" style="width: 100%; max-width: 400px;">
                    <input type="text" class="form-control text-white border-0 py-2 small" placeholder="Buscar hilos o tecnologías..." style="border-radius: 20px; background-color: #0F0F12 !important;" disabled>
                </div>

                <ul class="navbar-nav gap-4 align-items-center mb-0">
                    <li class="nav-item">
                        <a class="nav-social-link active" asp-controller="Home" asp-action="Index">Feed</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-social-link" href="#">Espacios</a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-social-link dropdown-toggle d-flex align-items-center gap-1" href="#" id="navbarAccountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <span>Hola, @User.Identity.Name</span>
                            }
                            else
                            {
                                <span>Account</span>
                            }
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark-custom shadow" aria-labelledby="navbarAccountDropdown">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                        👤 Ver mi Perfil
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider border-social"></li>
                                <li>
                                    <a class="dropdown-item py-2 text-danger fw-semibold" asp-controller="Account" asp-action="Logout">
                                        🚪 Cerrar Sesión
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Login">
                                        🔑 Iniciar Sesión
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Register">
                                        ✨ Crear Cuenta
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="flex-grow-1">
        @RenderBody()
    </div>

    <footer class="text-muted bg-social-card border-top border-social py-4 mt-5">
        <div class="container text-center">
            <p class="small mb-1 text-secondary">&copy; 2026 NetForum Platform. Diseñado como un producto digital nativo en .NET 10.</p>
            <span class="badge bg-dark text-secondary border border-social px-3 py-1" style="font-size: 0.75rem;">PA Module // Cluster Alpha</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)</body>
</html>