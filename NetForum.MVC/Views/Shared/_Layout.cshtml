<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NetForum</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                background-color: #0F0F12 !important;
                color: #E4E4E7 !important;
                font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            }
            .bg-social-card { background-color: #16161D !important; }
            .border-social { border-color: #23232F !important; }
            .text-violet-neon { color: #A78BFA !important; }

            .btn-violet-neon {
                background-color: #8B5CF6 !important;
                color: #ffffff !important;
                border: none;
                transition: all 0.2s ease;
            }
            .btn-violet-neon:hover {
                background-color: #7C3AED !important;
                transform: translateY(-1px);
            }
            .btn-outline-neon {
                border: 1px solid #23232F !important;
                color: #E4E4E7 !important;
                transition: all 0.2s;
            }
            .btn-outline-neon:hover {
                background-color: #23232F !important;
                color: #ffffff !important;
            }
            .nav-social-link {
                color: #A1A1AA !important;
                font-weight: 500;
                text-decoration: none;
                transition: color 0.2s;
            }
            .nav-social-link:hover, .nav-social-link.active {
                color: #8B5CF6 !important;
            }
    </style>
</head>
<body class="d-flex flex-column" style="min-height: 100vh;">

    <nav class="navbar navbar-expand-md bg-social-card border-bottom border-social sticky-top py-2 px-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-white fs-3 d-flex align-items-center" asp-controller="Home" asp-action="Index" style="letter-spacing: -1px; text-decoration: none;">
                Net<span class="text-violet-neon">Forum</span>
            </a>

            <div class="collapse navbar-collapse d-flex justify-content-between">
                <div class="mx-auto d-none d-md-block" style="width: 100%; max-width: 400px;">
                    <input type="text" class="form-control text-white border-0 py-2 small" placeholder="Buscar hilos o tecnologías..." style="border-radius: 20px; background-color: #0F0F12 !important;" disabled>
                </div>

                <ul class="navbar-nav gap-4 align-items-center mb-0">
                    <li class="nav-item">
                        <a class="nav-social-link active" asp-controller="Home" asp-action="Index">Feed</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-social-link" href="#">Espacios</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-violet-neon fw-bold px-4" asp-controller="Account" asp-action="Login" style="border-radius: 20px;">
                            Iniciar Sesión
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="flex-grow-1">
        @RenderBody()
    </div>

    <footer class="text-muted bg-social-card border-top border-social py-4 mt-5">
        <div class="container text-center">
            <p class="small mb-1 text-secondary">&copy; 2026 NetForum Platform. Diseñado como un producto digital nativo en .NET 10.</p>
            <span class="badge bg-dark text-secondary border border-social px-3 py-1" style="font-size: 0.75rem;">PA Module // Cluster Alpha</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>