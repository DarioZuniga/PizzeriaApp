@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso Denegado - Las Perlas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { background: #f4f6f9; min-height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Segoe UI', sans-serif; }
        .card-denied { background: white; padding: 40px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); max-width: 500px; text-align: center; }
    </style>
</head>
<body>
    <div class="card-denied">
        <i class="fa-solid fa-shield-halved text-danger fa-5x mb-3"></i>
        <h2 class="fw-bold" style="color: #1a365d;">Acceso Denegado</h2>
        <p class="text-muted">No tenés permisos para acceder a esta página.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3" style="background-color: #1a365d;">
            <i class="fa-solid fa-house me-2"></i> Volver al Inicio
        </a>
    </div>
</body>
</html>