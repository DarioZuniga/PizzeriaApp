@{
    ViewData["Title"] = "Correo Enviado";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Correo Enviado - PizzeriaApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { background-color: #f4f6f9; display: flex; align-items: center; justify-content: center; min-height: 100vh; font-family: "Segoe UI", sans-serif; margin: 0; }
        .card-email { background: #ffffff; padding: 40px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.08); width: 100%; max-width: 500px; }
    </style>
</head>
<body>
    <div class="card-email text-center">
        <i class="fa-solid fa-envelope-circle-check text-success fa-4x mb-3"></i>
        <h3 class="fw-bold" style="color: #1a365d;">¡Correo Enviado!</h3>
        <p class="text-muted">Hemos enviado un enlace de recuperación a:</p>
        <h5 class="fw-bold">@ViewBag.Correo</h5>
        <hr />
        @if (!string.IsNullOrEmpty(ViewBag.Enlace))
        {
            <div class="alert alert-info small">
                <p class="mb-2"><strong>(Simulación de Correo)</strong></p>
                <p class="mb-3">Haz clic en el siguiente botón para restablecer tu contraseña:</p>
                <a href="@ViewBag.Enlace" class="btn btn-primary w-100" style="background-color: #1a365d;">
                    <i class="fa-solid fa-key me-2"></i> Restablecer Contraseña
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-warning small">
                Si el correo está registrado, recibirás un enlace de recuperación.
            </div>
        }
        <div class="mt-4">
            <a asp-action="Login" class="text-decoration-none small" style="color: #1a365d;">
                <i class="fa-solid fa-arrow-left me-1"></i> Volver al inicio de sesión
            </a>
        </div>
    </div>
</body>
</html>
