@model PizzeriaApp.MVC.Models.PerfilViewModel

@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 style="color:#1a365d;">
            <i class="fa-solid fa-user-circle me-2"></i> Mi Perfil
        </h2>
        <p class="text-muted">Consulta y actualiza la información de tu cuenta.</p>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                         style="width:90px;height:90px;background:#e9eff7;color:#1a365d;">
                        <i class="fa-solid fa-user fa-3x"></i>
                    </div>

                    <h4 class="fw-bold" style="color:#1a365d;">@Model.NombreUsuario</h4>
                    <p class="text-muted text-break">@Model.Correo</p>

                    <hr />

                    <div class="text-start mb-3">
                        <small class="text-muted">Rol de cuenta</small>
                        <div class="fw-semibold">
                            <i class="fa-solid fa-shield-halved me-2"></i>@Model.Rol
                        </div>
                    </div>

                    <div class="text-start mb-3">
                        <small class="text-muted">Estado</small>
                        <div class="fw-semibold">
                            <i class="fa-solid fa-circle-check me-2 text-success"></i>@Model.Estado
                        </div>
                    </div>

                    <div class="text-start">
                        <small class="text-muted">Fecha de registro</small>
                        <div class="fw-semibold">
                            <i class="fa-solid fa-calendar me-2"></i>
                            @Model.FechaRegistro.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4" style="color:#1a365d;">
                        <i class="fa-solid fa-pen-to-square me-2"></i>
                        Editar información personal
                    </h5>

                    <form asp-controller="Account" asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="NombreUsuario" class="form-label fw-semibold"></label>
                            <input asp-for="NombreUsuario" class="form-control"
                                   placeholder="Tu nombre de usuario" />
                            <span asp-validation-for="NombreUsuario"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Correo" class="form-label fw-semibold"></label>
                            <input asp-for="Correo" class="form-control"
                                   type="email" placeholder="correo@ejemplo.com" />
                            <span asp-validation-for="Correo"
                                  class="text-danger small"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-floppy-disk me-2"></i>
                                Guardar cambios
                            </button>

                            <a asp-controller="Home" asp-action="Index"
                               class="btn btn-outline-secondary">
                                <i class="fa-solid fa-arrow-left me-2"></i>
                                Volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="alert alert-light border mt-3">
                <i class="fa-solid fa-lock me-2"></i>
                Tu contraseña y tus permisos no se modifican desde esta pantalla.
            </div>
        </div>
    </div>
</div>
