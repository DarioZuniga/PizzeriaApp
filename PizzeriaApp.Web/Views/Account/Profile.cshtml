@{
    ViewData["Title"] = "Mi Perfil";
}
<div class="container mt-4">
    <h2 style="color: #1a365d;"><i class="fa-solid fa-user me-2"></i> Mi Perfil</h2>
    <hr />
    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-4">
            <p><strong>Usuario:</strong> @User.Identity?.Name</p>
            <p><strong>Correo:</strong> @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
            <p><strong>Rol:</strong> @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</p>
            <hr />
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>
</div>