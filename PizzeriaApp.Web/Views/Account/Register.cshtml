@model PizzeriaApp.MVC.Models.RegisterViewModel
@{
    ViewData["Title"] = "Registro";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro - Las Perlas</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Montserrat:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Montserrat', sans-serif; margin: 0; padding: 20px; }
        .login-card { background: rgba(255, 255, 255, 0.95); padding: 40px; border-radius: 20px; box-shadow: 0 25px 50px rgba(0,0,0,0.3); width: 100%; max-width: 450px; backdrop-filter: blur(10px); }
        .login-logo { text-align: center; margin-bottom: 20px; }
        .login-logo img { height: 70px; margin-bottom: 10px; }
        .login-logo h2 { font-family: 'Playfair Display', serif; font-size: 1.8rem; font-weight: 600; color: #0f172a; }
        .form-label { font-weight: 600; color: #334155; font-size: 0.9rem; }
        .form-control { border-radius: 10px; border: 1px solid #cbd5e1; padding: 10px 15px; background: #f8fafc; }
        .form-control:focus { border-color: #d4af37; box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2); }
        .btn-primary { background-color: #0f172a; border: none; font-weight: 600; padding: 12px; border-radius: 10px; transition: all 0.3s; }
        .btn-primary:hover { background-color: #d4af37; color: #0f172a; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-logo">
            <img src="~/favicon.png" alt="Logo Las Perlas" />
            <h2>Las Perlas</h2>
        </div>
        <p class="text-center text-muted mb-4 small">Crea tu cuenta y accede a beneficios exclusivos</p>
        
        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0"></div>

            <div class="mb-3">
                <label asp-for="NombreUsuario" class="form-label">Nombre Completo</label>
                <input asp-for="NombreUsuario" class="form-control" placeholder="Tu nombre" required />
                <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Correo Electrónico</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="correo@ejemplo.com" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Contraseña</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Confirmar Contraseña</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">CREAR CUENTA</button>

            <div class="text-center mt-3">
                <span class="text-muted small">¿Ya eres miembro?</span>
                <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-bold small" style="color: #d4af37;">Inicia Sesión</a>
            </div>
        </form>
    </div>
</body>
</html>