@{
    ViewData["Title"] = "Nueva Contraseña";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nueva Contraseña - Las Perlas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { background: linear-gradient(135deg, #0f172a 0%, #1a365d 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Segoe UI', sans-serif; }
        .card-login { background: white; padding: 40px; border-radius: 16px; box-shadow: 0 20px 50px rgba(0,0,0,0.3); width: 100%; max-width: 420px; }
        .btn-lp { background-color: #1a365d; color: white; font-weight: 600; padding: 12px; border-radius: 8px; border: none; width: 100%; }
        .btn-lp:hover { background-color: #d4af37; color: #0f172a; }
    </style>
</head>
<body>
    <div class="card-login">
        <div class="text-center mb-4">
            <i class="fa-solid fa-lock fa-3x mb-2" style="color: #d4af37;"></i>
            <h2 class="fw-bold" style="color: #1a365d;">Nueva Contraseña</h2>
            <p class="text-muted small">Ingresá tu nueva contraseña.</p>
        </div>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <input type="hidden" name="token" value="@ViewBag.Token" />
            <div class="mb-3">
                <label class="form-label fw-bold">Nueva Contraseña</label>
                <input name="nuevaPassword" type="password" class="form-control" required minlength="6" />
            </div>
            <button type="submit" class="btn btn-lp mb-3">Cambiar Contraseña</button>
        </form>

        <div class="text-center">
            <a asp-action="Login" class="text-muted small">
                <i class="fa-solid fa-arrow-left me-1"></i> Volver al inicio
            </a>
        </div>
    </div>
</body>
</html>