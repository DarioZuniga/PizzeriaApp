@{
    ViewData["Title"] = "Nueva Contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nueva Contraseña - PizzeriaApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { background-color: #f4f6f9; height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; }
        .login-card { background: #ffffff; padding: 40px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.08); width: 100%; max-width: 420px; }
        .login-logo { text-align: center; font-size: 2rem; font-weight: 800; color: #1a365d; margin-bottom: 30px; letter-spacing: -1px; text-transform: uppercase; }
        .login-logo i { color: #e53e3e; }
        .form-label { font-weight: 600; color: #2d3748; }
        .form-control { border-radius: 6px; border: 1px solid #cbd5e0; padding: 10px 12px; }
        .form-control:focus { border-color: #1a365d; box-shadow: 0 0 0 3px rgba(26, 54, 93, 0.1); }
        .btn-primary { background-color: #1a365d; border-color: #1a365d; font-weight: 600; padding: 12px; border-radius: 6px; }
        .btn-primary:hover { background-color: #2b6cb0; border-color: #2b6cb0; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-logo">
            <i class="fa-solid fa-pizza-slice"></i> PizzeriaApp
        </div>
        <h4 class="text-center mb-4" style="color: #2d3748;">Nueva Contraseña</h4>
        <p class="text-muted text-center mb-4">Ingresá tu nueva contraseña para restablecer el acceso.</p>
        <form asp-action="ResetPassword" method="post">
            <input type="hidden" name="token" value="@ViewBag.Token" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-4">
                <label class="form-label">Nueva Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                    <input type="password" name="nuevaPassword" class="form-control" placeholder="••••••••" required minlength="6" />
                </div>
                <small class="text-muted">Mínimo 6 caracteres.</small>
            </div>
            <button type="submit" class="btn btn-primary w-100">
                <i class="fa-solid fa-check me-2"></i> Cambiar Contraseña
            </button>
        </form>
    </div>
</body>
</html>
