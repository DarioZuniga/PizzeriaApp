@model List<PizzeriaApp.MVC.Models.CarritoItem>
@{
    ViewData["Title"] = "Mi Carrito";
    var subtotal = Model.Sum(i => i.PrecioTotal);
    var impuestos = subtotal * 0.13m;
    var total = subtotal + impuestos;
}

<div class="container mt-4">
    <h2 style="color: #1a365d;">🛒 Mi Carrito</h2>
    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <h4>Tu carrito está vacío</h4>
            <p>Ve al menú y agrega tus pizzas favoritas.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3" style="background-color: #1a365d;">Ver Menú</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                    <div class="card-body">
                        @foreach (var item in Model)
                        {
                            <div class="d-flex justify-content-between border-bottom py-3">
                                <div>
                                    <h5 class="fw-bold mb-1">@item.Nombre</h5>
                                    <p class="small text-muted mb-0">
                                        @if (!string.IsNullOrEmpty(item.TamanoNombre)) { <span>Tamaño: @item.TamanoNombre. </span> }
                                        @if (!string.IsNullOrEmpty(item.TipoMasaNombre)) { <span>Masa: @item.TipoMasaNombre. </span> }
                                        @if (item.IngredientesNombres.Any()) { <span>Ingredientes: @string.Join(", ", item.IngredientesNombres)</span> }
                                    </p>
                                    <small>Cantidad: @item.Cantidad</small>
                                </div>
                                <div class="text-end">
                                    <h5 class="fw-bold text-danger">₡@(item.PrecioTotal.ToString("N2"))</h5>
                                    <form asp-action="Eliminar" method="post">
                                        <input type="hidden" name="index" value="@Model.IndexOf(item)" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger mt-2">Eliminar</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                    <div class="card-body">
                        <h4 class="fw-bold">Resumen</h4>
                        <hr />
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span>₡@(subtotal.ToString("N2"))</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>IVA (13%):</span>
                            <span>₡@(impuestos.ToString("N2"))</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5 mb-3">
                            <span>Total:</span>
                            <span class="text-danger">₡@(total.ToString("N2"))</span>
                        </div>
                        <form asp-action="ConfirmarPedido" method="post">
                            <button type="submit" class="btn btn-primary w-100 btn-lg" style="background-color: #1a365d;">Confirmar Pedido</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
