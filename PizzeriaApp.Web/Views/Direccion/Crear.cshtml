@model PizzeriaApp.Data.Entities.Direccion
@{ ViewData["Title"] = "Nueva Dirección"; }
<div class="container mt-4">
    <div class="card border-0 shadow-sm" style="border-radius: 12px; max-width: 600px; margin: auto;">
        <div class="card-body p-4">
            <h3 class="mb-4" style="color: #1a365d;">Agregar Dirección</h3>
            <form asp-action="Crear" method="post">
                <div class="mb-3">
                    <label class="fw-bold">Alias (Ej: Casa)</label>
                    <input asp-for="Alias" class="form-control" required />
                </div>
                <div class="mb-4">
                    <label class="fw-bold">Detalle de la ubicación</label>
                    <textarea asp-for="Detalle" class="form-control" rows="3" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary" style="background-color: #1a365d;">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>