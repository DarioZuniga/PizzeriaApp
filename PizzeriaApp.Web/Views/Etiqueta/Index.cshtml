@model IEnumerable<PizzeriaApp.Data.Entities.Etiqueta>

@{
    ViewData["Title"] = "Gestión de Etiquetas";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white">
                <i class="fa-solid fa-tags text-success me-2"></i>
                Gestión de Etiquetas
            </h2>
            <p class="text-secondary mb-0">
                Administra etiquetas para clasificar temas del foro.
            </p>
        </div>

        <button class="btn btn-football px-4" data-bs-toggle="modal" data-bs-target="#etiquetaModal" onclick="abrirCrearEtiqueta()">
            <i class="fa-solid fa-plus me-2"></i>
            Nueva Etiqueta
        </button>
    </div>

    <div class="dashboard-panel">
        <div class="table-responsive">
            <table id="etiquetasTable" class="table table-dark table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th>Nombre</th>
                        <th style="width:170px;" class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-id="@item.EtiquetaId">
                            <td>@item.EtiquetaId</td>
                            <td class="fw-semibold">
                                <span class="badge bg-dark border border-social text-success px-3 py-2">
                                    #@item.Nombre
                                </span>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-warning btn-sm" onclick="abrirEditarEtiqueta(@item.EtiquetaId)">
                                    <i class="fa-solid fa-pen"></i>
                                </button>

                                <button class="btn btn-danger btn-sm" onclick="eliminarEtiqueta(@item.EtiquetaId, '@item.Nombre')">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="etiquetaModal" tabindex="-1" aria-labelledby="etiquetaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-social-card border border-social text-white" style="border-radius: 18px;">
            <div class="modal-header border-social">
                <h5 class="modal-title fw-bold" id="etiquetaModalLabel">
                    Nueva Etiqueta
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="etiquetaId" />

                <div class="mb-3">
                    <label class="form-label text-secondary fw-semibold">Nombre</label>
                    <input type="text" id="nombreEtiqueta" class="form-control bg-dark text-white border-secondary" placeholder="Ej: Fichajes" />
                    <span id="nombreEtiquetaError" class="text-warning small"></span>
                </div>
            </div>

            <div class="modal-footer border-social">
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button" class="btn btn-football" onclick="guardarEtiqueta()">
                    <i class="fa-solid fa-save me-2"></i>
                    Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let etiquetasTable;

        $(document).ready(function () {
            etiquetasTable = $('#etiquetasTable').DataTable({
                language: {
                    url: "https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json"
                },
                pageLength: 5,
                lengthMenu: [5, 10, 25, 50],
                order: [[1, "asc"]],
                columnDefs: [
                    { orderable: false, targets: 2 }
                ],
                layout: {
                    topStart: {
                        buttons: [
                            {
                                extend: 'excelHtml5',
                                text: '<i class="fa-solid fa-file-excel me-1"></i> Excel',
                                className: 'btn btn-success btn-sm'
                            },
                            {
                                extend: 'pdfHtml5',
                                text: '<i class="fa-solid fa-file-pdf me-1"></i> PDF',
                                className: 'btn btn-danger btn-sm'
                            },
                            {
                                extend: 'print',
                                text: '<i class="fa-solid fa-print me-1"></i> Imprimir',
                                className: 'btn btn-secondary btn-sm'
                            }
                        ]
                    }
                }
            });
        });

        function obtenerToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        function limpiarFormularioEtiqueta() {
            document.getElementById("etiquetaId").value = "";
            document.getElementById("nombreEtiqueta").value = "";
            document.getElementById("nombreEtiquetaError").innerText = "";
        }

        function abrirCrearEtiqueta() {
            limpiarFormularioEtiqueta();
            document.getElementById("etiquetaModalLabel").innerText = "Nueva Etiqueta";
        }

        async function abrirEditarEtiqueta(id) {
            limpiarFormularioEtiqueta();

            const response = await fetch(`/Etiqueta/GetById/${id}`);

            if (!response.ok) {
                mostrarError("No se pudo cargar la etiqueta.");
                return;
            }

            const etiqueta = await response.json();

            document.getElementById("etiquetaId").value = etiqueta.etiquetaId;
            document.getElementById("nombreEtiqueta").value = etiqueta.nombre;
            document.getElementById("etiquetaModalLabel").innerText = "Editar Etiqueta";

            const modal = new bootstrap.Modal(document.getElementById("etiquetaModal"));
            modal.show();
        }

        async function guardarEtiqueta() {
            const id = document.getElementById("etiquetaId").value;
            const nombre = document.getElementById("nombreEtiqueta").value.trim();

            document.getElementById("nombreEtiquetaError").innerText = "";

            if (!nombre) {
                document.getElementById("nombreEtiquetaError").innerText = "El nombre es obligatorio.";
                return;
            }

            const formData = new FormData();
            formData.append("__RequestVerificationToken", obtenerToken());
            formData.append("Nombre", nombre);

            const url = id
                ? `/Etiqueta/EditAjax/${id}`
                : `/Etiqueta/CreateAjax`;

            const response = await fetch(url, {
                method: "POST",
                body: formData
            });

            if (!response.ok) {
                mostrarError("No se pudo guardar la etiqueta.");
                return;
            }

            const result = await response.json();

            if (result.success) {
                Swal.fire({
                    icon: "success",
                    title: "Correcto",
                    text: result.message,
                    timer: 1500,
                    showConfirmButton: false,
                    background: "#16161D",
                    color: "#E4E4E7"
                }).then(() => location.reload());
            }
        }

        function eliminarEtiqueta(id, nombre) {
            Swal.fire({
                title: "¿Eliminar etiqueta?",
                text: `Se eliminará "#${nombre}". Esta acción no se puede deshacer.`,
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#dc3545",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Sí, eliminar",
                cancelButtonText: "Cancelar",
                background: "#16161D",
                color: "#E4E4E7"
            }).then(async (result) => {
                if (!result.isConfirmed) {
                    return;
                }

                const formData = new FormData();
                formData.append("__RequestVerificationToken", obtenerToken());

                const response = await fetch(`/Etiqueta/DeleteAjax/${id}`, {
                    method: "POST",
                    body: formData
                });

                if (!response.ok) {
                    mostrarError("No se pudo eliminar la etiqueta.");
                    return;
                }

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: "success",
                        title: "Eliminada",
                        text: data.message,
                        timer: 1500,
                        showConfirmButton: false,
                        background: "#16161D",
                        color: "#E4E4E7"
                    }).then(() => location.reload());
                }
            });
        }

        function mostrarError(mensaje) {
            Swal.fire({
                icon: "error",
                title: "Error",
                text: mensaje,
                background: "#16161D",
                color: "#E4E4E7"
            });
        }
    </script>
}