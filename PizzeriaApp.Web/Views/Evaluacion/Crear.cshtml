@{ ViewData["Title"] = "Evaluar Servicio"; }
<div class="container mt-4">
    <div class="card border-0 shadow-sm" style="border-radius: 12px; max-width: 500px; margin: auto;">
        <div class="card-body p-4 text-center">
            <h3 class="mb-4" style="color: #1a365d;">⭐ Calificar Servicio</h3>
            <form asp-action="Crear" method="post">
                <input type="hidden" name="pedidoId" value="@ViewBag.PedidoId" />
                <div class="mb-3">
                    <label class="fw-bold">Calificación (1 al 10)</label>
                    <input type="number" name="calificacion" min="1" max="10" class="form-control text-center fs-3" required />
                </div>
                <div class="mb-4">
                    <label class="fw-bold">Comentario (Opcional)</label>
                    <textarea name="comentario" class="form-control" rows="3"></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-100" style="background-color: #1a365d;">Enviar Evaluación</button>
            </form>
        </div>
    </div>
</div>