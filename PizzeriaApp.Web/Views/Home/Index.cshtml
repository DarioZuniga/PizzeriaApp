@model PizzeriaApp.MVC.Models.DashboardViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Inicio";
    var nombreUsuario = Model.NombreUsuario;
}

<div class="container py-5">

    <!-- HERO SECTION (Estilo Noticias) -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-10 text-center">
            <h1 class="display-4 fw-bold mb-3" style="color: #1a365d;">
                Hola, @nombreUsuario 👋
            </h1>
            <p class="lead text-muted">
                Bienvenido a PizzeriaApp. Descubre las últimas noticias, guarda tus artículos favoritos y debate con la comunidad.
            </p>
            <div class="mt-4">
                <a asp-controller="Foro" asp-action="Index" class="btn btn-primary px-4 py-2 fw-bold">
                    <i class="fa-solid fa-newspaper me-2"></i> Explorar Noticias
                </a>
            </div>
        </div>
    </div>

    <!-- METRICS CARDS (Estilo Login) -->
    <div class="row g-4 mb-5 justify-content-center">
        <div class="col-lg-3 col-md-6">
            <div class="card h-100 p-4 border-0 shadow-sm text-center" style="border-radius: 12px;">
                <i class="fa-solid fa-users fa-2x mb-3" style="color: #1a365d;"></i>
                <h2 class="fw-bold mb-1" style="color: #1a365d;">@Model.TotalUsuarios</h2>
                <span class="text-muted fw-semibold">Usuarios</span>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card h-100 p-4 border-0 shadow-sm text-center" style="border-radius: 12px;">
                <i class="fa-solid fa-comments fa-2x mb-3" style="color: #1a365d;"></i>
                <h2 class="fw-bold mb-1" style="color: #1a365d;">@Model.TotalTemas</h2>
                <span class="text-muted fw-semibold">Noticias</span>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card h-100 p-4 border-0 shadow-sm text-center" style="border-radius: 12px;">
                <i class="fa-solid fa-message fa-2x mb-3" style="color: #1a365d;"></i>
                <h2 class="fw-bold mb-1" style="color: #1a365d;">@Model.TotalRespuestas</h2>
                <span class="text-muted fw-semibold">Comentarios</span>
            </div>
        </div>
    </div>

    <!-- NOTICIAS DESTACADAS (Estilo Tarjetas Limpias) -->
    <div class="row mb-5">
        <div class="col-12 mb-3">
            <h3 class="fw-bold" style="color: #1a365d;">
                <i class="fa-solid fa-fire text-danger me-2"></i> Noticias Destacadas
            </h3>
            <p class="text-muted">Lo más reciente de la comunidad.</p>
        </div>

        @if (!Model.TemasDestacados.Any())
        {
            <div class="col-12">
                <div class="alert alert-light border text-center py-4">
                    <h5 class="text-muted">Aún no hay noticias destacadas</h5>
                    <p class="mb-0">Las noticias más activas aparecerán aquí.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var tema in Model.TemasDestacados)
            {
                <div class="col-lg-6 mb-4">
                    <a asp-controller="Foro" asp-action="Detalle" asp-route-id="@tema.TemaId" class="text-decoration-none">
                        <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px;">
                            <div class="card-body d-flex gap-3">
                                <!-- Avatar -->
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold flex-shrink-0"
                                     style="width: 50px; height: 50px; background-color: #1a365d;">
                                    @tema.Iniciales
                                </div>

                                <div>
                                    <h5 class="card-title fw-bold mb-1" style="color: #1a365d;">@tema.Titulo</h5>
                                    <p class="card-text text-muted small mb-2">@tema.Resumen</p>

                                    <div class="d-flex gap-3 text-muted small">
                                        <span><i class="fa-solid fa-comment me-1"></i> @tema.CantidadRespuestas</span>
                                        <span><i class="fa-solid fa-heart me-1"></i> @tema.CantidadReacciones</span>
                                        <span><i class="fa-solid fa-clock me-1"></i> @tema.FechaCreacion.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
    </div>

    <!-- GRÁFICOS (Estilo Claro) -->
    <div class="row g-4">
        <!-- Temas por categoría -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px;">
                <h5 class="fw-bold mb-3" style="color: #1a365d;">
                    <i class="fa-solid fa-chart-column me-2"></i> Noticias por categoría
                </h5>

                @if (!Model.TemasPorCategoria.Any())
                {
                    <div class="text-center text-muted py-4">No hay datos para mostrar.</div>
                }
                else
                {
                    <div style="height: 250px; position: relative;">
                        <canvas id="temasCategoriaChart"></canvas>
                    </div>
                }
            </div>
        </div>

        <!-- Respuestas por día -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px;">
                <h5 class="fw-bold mb-3" style="color: #1a365d;">
                    <i class="fa-solid fa-chart-line me-2"></i> Actividad reciente
                </h5>

                @if (!Model.RespuestasPorDia.Any())
                {
                    <div class="text-center text-muted py-4">No hay datos para mostrar.</div>
                }
                else
                {
                    <div style="height: 250px; position: relative;">
                        <canvas id="respuestasDiaChart"></canvas>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Configuración global de Chart.js para que se vea claro y limpio
            Chart.defaults.color = "#718096"; // Color de letra gris
            Chart.defaults.borderColor = "rgba(0,0,0,0.05)"; // Líneas de fondo sutiles

            // 1. GRÁFICO CATEGORÍA
            const canvasCategoria = document.getElementById("temasCategoriaChart");
            if (canvasCategoria) {
                const categorias = @Html.Raw(JsonSerializer.Serialize(Model.TemasPorCategoria.Select(x => x.Categoria)));
                const cantidadesCat = @Html.Raw(JsonSerializer.Serialize(Model.TemasPorCategoria.Select(x => x.Cantidad)));

                new Chart(canvasCategoria, {
                    type: "bar",
                    data: {
                        labels: categorias,
                        datasets: [{
                            label: "Noticias",
                            data: cantidadesCat,
                            backgroundColor: "#1a365d", // Azul de noticias
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false } },
                            y: { beginAtZero: true, ticks: { precision: 0, stepSize: 1 } }
                        }
                    }
                });
            }

            // 2. GRÁFICO ACTIVIDAD (Línea)
            const canvasRespuestas = document.getElementById("respuestasDiaChart");
            if (canvasRespuestas) {
                const fechas = @Html.Raw(JsonSerializer.Serialize(Model.RespuestasPorDia.Select(x => x.Fecha.ToString("dd/MM"))));
                const cantidadesResp = @Html.Raw(JsonSerializer.Serialize(Model.RespuestasPorDia.Select(x => x.Cantidad)));

                new Chart(canvasRespuestas, {
                    type: "line",
                    data: {
                        labels: fechas,
                        datasets: [{
                            label: "Actividad",
                            data: cantidadesResp,
                            borderColor: "#1a365d",
                            backgroundColor: "rgba(26, 54, 93, 0.1)",
                            borderWidth: 3,
                            tension: 0.35,
                            fill: true,
                            pointBackgroundColor: "#1a365d",
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false } },
                            y: { beginAtZero: true, ticks: { precision: 0, stepSize: 1 } }
                        }
                    }
                });
            }
        });
    </script>
}