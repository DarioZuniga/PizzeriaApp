@model IEnumerable<PizzeriaApp.Data.Entities.Insumo>
@{ ViewData["Title"] = "Conteo Físico"; }

<style>
    .admin-header {
        background: linear-gradient(135deg, #0f172a 0%, #1a365d 100%);
        border-radius: 24px; padding: 35px; color: white; margin-bottom: 30px;
        position: relative; overflow: hidden;
    }
    .admin-header::before {
        content: '📋'; position: absolute; right: -20px; bottom: -40px;
        font-size: 10rem; opacity: 0.08;
    }
    .admin-header h1 { font-size: 1.9rem; font-weight: 800; margin: 0; position: relative; }
    .admin-header p { margin: 6px 0 0 0; opacity: 0.85; position: relative; }
    .tabla-premium {
        background: white; border-radius: 20px; overflow: hidden;
        box-shadow: 0 10px 30px rgba(15,23,42,0.08);
    }
    .tabla-premium table { margin: 0; width: 100%; }
    .tabla-premium thead { background: linear-gradient(135deg, #1a365d, #2c5282); color: white; }
    .tabla-premium thead th { padding: 18px 20px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 700; border: none; }
    .tabla-premium tbody td { padding: 18px 20px; border-bottom: 1px solid #e2e8f0; vertical-align: middle; }
    .input-conteo {
        padding: 8px 12px; border: 2px solid #e2e8f0; border-radius: 8px;
        width: 100px; font-weight: 700; color: #1a365d;
    }
    .input-conteo:focus { border-color: #d4af37; outline: none; box-shadow: 0 0 0 3px rgba(212,175,55,0.15); }
    .btn-submit-premium {
        background: linear-gradient(135deg, #1a365d, #2c5282); color: white;
        border: none; padding: 16px 32px; border-radius: 12px; font-weight: 700;
        font-size: 1rem; transition: all 0.3s;
    }
    .btn-submit-premium:hover { transform: translateY(-2px); }
</style>

<div class="container mt-4">
    <div class="admin-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1><i class="fa-solid fa-clipboard-check me-2"></i>Conteo Físico</h1>
                <p>Ajustá el stock real contando los insumos</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-light" style="border-radius: 50px; padding: 12px 24px; font-weight: 700;">
                <i class="fa-solid fa-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>

    <form asp-action="ConteoFisico" method="post">
        <div class="tabla-premium mb-4">
            <table>
                <thead>
                    <tr>
                        <th>Insumo</th>
                        <th>Unidad</th>
                        <th>Stock Sistema</th>
                        <th>Cantidad Real</th>
                        <th>Diferencia</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        <tr>
                            <td><strong>@i.Nombre</strong></td>
                            <td>@i.UnidadMedida</td>
                            <td><span style="font-weight: 700; color: #1a365d;">@i.StockActual.ToString("N2")</span></td>
                            <td>
                                <input type="number" step="0.01" name="conteos[@i.InsumoId]" value="@i.StockActual" class="input-conteo" />
                            </td>
                            <td>
                                <span class="diferencia" data-stock="@i.StockActual">—</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-center">
            <button type="submit" class="btn-submit-premium">
                <i class="fa-solid fa-save me-2"></i> Aplicar Ajuste
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const inputs = document.querySelectorAll('.input-conteo');
        inputs.forEach(input => {
            input.addEventListener('input', () => {
                const stockSistema = parseFloat(input.closest('tr').querySelector('.diferencia').dataset.stock);
                const real = parseFloat(input.value) || 0;
                const diff = real - stockSistema;
                const span = input.closest('tr').querySelector('.diferencia');
                if (diff === 0) {
                    span.textContent = '—';
                    span.style.color = '#64748b';
                } else {
                    span.textContent = (diff > 0 ? '+' : '') + diff.toFixed(2);
                    span.style.color = diff > 0 ? '#16a34a' : '#dc2626';
                    span.style.fontWeight = '700';
                }
            });
        });
    </script>
}