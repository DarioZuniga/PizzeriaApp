@model PizzeriaApp.Data.Entities.Insumo
@{
    ViewData["Title"] = "Nuevo Insumo";
}

<div class="container mt-4">
    <div class="card border-0 shadow-sm" style="border-radius: 12px; max-width: 600px; margin: auto;">
        <div class="card-body p-4">
            <h3 class="mb-4" style="color: #1a365d;">Nuevo Insumo</h3>
            <form asp-action="CrearInsumo" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold">Nombre del Insumo</label>
                    <input asp-for="Nombre" class="form-control" required placeholder="Ej: Harina, Queso Mozzarella" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="UnidadMedida" class="form-label fw-bold">Unidad de Medida</label>
                        <input asp-for="UnidadMedida" class="form-control" required placeholder="Ej: kg, litros, unidades" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CostoUnitario" class="form-label fw-bold">Costo Unitario (₡)</label>
                        <input asp-for="CostoUnitario" type="number" step="0.01" class="form-control" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StockActual" class="form-label fw-bold">Stock Inicial</label>
                        <input asp-for="StockActual" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="StockMinimo" class="form-label fw-bold">Stock Mínimo (Alerta)</label>
                        <input asp-for="StockMinimo" type="number" step="0.01" class="form-control" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="FechaVencimiento" class="form-label fw-bold">Fecha de Vencimiento (Opcional)</label>
                    <input asp-for="FechaVencimiento" type="date" class="form-control" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" style="background-color: #1a365d;">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>