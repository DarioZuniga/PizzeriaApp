@{ ViewData["Title"] = "Historial de Precios"; }

<style>
    .admin-header {
        background: linear-gradient(135deg, #0f172a 0%, #1a365d 100%);
        border-radius: 24px; padding: 35px; color: white; margin-bottom: 30px;
        position: relative; overflow: hidden;
    }
    .admin-header::before {
        content: '📈'; position: absolute; right: -20px; bottom: -40px;
        font-size: 10rem; opacity: 0.08;
    }
    .admin-header h1 { font-size: 1.9rem; font-weight: 800; margin: 0; position: relative; }
    .admin-header p { margin: 6px 0 0 0; opacity: 0.85; position: relative; }
    .placeholder-card {
        background: white; border-radius: 20px; padding: 60px 40px;
        box-shadow: 0 10px 30px rgba(15,23,42,0.08); text-align: center;
    }
    .placeholder-icon { font-size: 5rem; opacity: 0.3; margin-bottom: 20px; }
    .placeholder-card h3 { color: #1a365d; font-weight: 800; margin-bottom: 10px; }
    .placeholder-card p { color: #64748b; margin: 0; }
</style>

<div class="container mt-4">
    <div class="admin-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1><i class="fa-solid fa-chart-line me-2"></i>Historial de Precios</h1>
                <p>Evolución de precios de compra a proveedores</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-light" style="border-radius: 50px; padding: 12px 24px; font-weight: 700;">
                <i class="fa-solid fa-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>

    <div class="placeholder-card">
        <div class="placeholder-icon">📊</div>
        <h3>Módulo en Construcción</h3>
        <p>El historial de precios se poblará automáticamente cuando registres órdenes de compra a proveedores.</p>
    </div>
</div>