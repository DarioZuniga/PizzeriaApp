@model IEnumerable<PizzeriaApp.Data.Entities.Insumo>
@{
    ViewData["Title"] = "Inventario";
    var totalInsumos = Model.Count();
    var bajoStock = Model.Count(i => i.StockActual <= i.StockMinimo);
    var valorTotal = Model.Sum(i => i.StockActual * i.CostoUnitario);
}

<style>
    .admin-header {
        background: linear-gradient(135deg, #0f172a 0%, #1a365d 100%);
        border-radius: 24px; padding: 35px; color: white; margin-bottom: 30px;
        position: relative; overflow: hidden;
    }
    .admin-header::before {
        content: '📦'; position: absolute; right: -20px; bottom: -40px;
        font-size: 10rem; opacity: 0.08;
    }
    .admin-header h1 { font-size: 1.9rem; font-weight: 800; margin: 0; position: relative; }
    .admin-header p { margin: 6px 0 0 0; opacity: 0.85; position: relative; }
    .btn-premium {
        background: linear-gradient(135deg, #d4af37, #b8941f); color: #0f172a;
        border: none; padding: 12px 24px; border-radius: 50px; font-weight: 700;
        text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
        transition: all 0.3s; box-shadow: 0 8px 20px rgba(212,175,55,0.3);
    }
    .btn-premium:hover { transform: translateY(-2px); color: #0f172a; }
    .btn-outline-premium {
        background: transparent; color: white; border: 2px solid rgba(255,255,255,0.3);
        padding: 10px 20px; border-radius: 50px; font-weight: 600; text-decoration: none;
        display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s;
    }
    .btn-outline-premium:hover { background: rgba(255,255,255,0.1); color: white; border-color: white; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 25px; }
    .stat-card {
        background: white; border-radius: 16px; padding: 25px;
        box-shadow: 0 8px 25px rgba(15,23,42,0.06); border: 1px solid #e2e8f0;
        display: flex; align-items: center; gap: 15px;
    }
    .stat-icon {
        width: 50px; height: 50px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; flex-shrink: 0;
    }
    .stat-info h3 { font-size: 1.6rem; font-weight: 800; margin: 0; color: #1a365d; }
    .stat-info p { margin: 0; color: #64748b; font-size: 0.85rem; }
    .tabla-premium {
        background: white; border-radius: 20px; overflow: hidden;
        box-shadow: 0 10px 30px rgba(15,23,42,0.08);
    }
    .tabla-premium table { margin: 0; width: 100%; }
    .tabla-premium thead { background: linear-gradient(135deg, #1a365d, #2c5282); color: white; }
    .tabla-premium thead th { padding: 18px 20px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 700; border: none; }
    .tabla-premium tbody td { padding: 18px 20px; border-bottom: 1px solid #e2e8f0; vertical-align: middle; }
    .tabla-premium tbody tr:hover { background: #f8fafc; }
    .stock-badge { padding: 6px 14px; border-radius: 50px; font-weight: 700; font-size: 0.85rem; }
    .stock-ok { background: #dcfce7; color: #16a34a; }
    .stock-bajo { background: #fef3c7; color: #d97706; }
    .stock-critico { background: #fee2e2; color: #dc2626; }
    .btn-accion {
        padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 0.85rem;
        text-decoration: none; border: none; transition: all 0.2s;
    }
    .btn-ver { background: #dbeafe; color: #1e40af; }
    .btn-ver:hover { background: #1e40af; color: white; }
</style>

<div class="container mt-4">
    <div class="admin-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h1><i class="fa-solid fa-boxes-stacked me-2"></i>Inventario</h1>
                <p>Control de stock de insumos</p>
            </div>
            <a asp-action="CrearInsumo" class="btn-premium">
                <i class="fa-solid fa-plus"></i> Nuevo Insumo
            </a>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="ConteoFisico" class="btn-outline-premium">
                <i class="fa-solid fa-clipboard-check"></i> Conteo Físico
            </a>
            <a asp-action="HistorialPrecios" class="btn-outline-premium">
                <i class="fa-solid fa-chart-line"></i> Historial Precios
            </a>
            <a asp-action="Movimientos" class="btn-outline-premium">
                <i class="fa-solid fa-arrow-right-arrow-left"></i> Movimientos
            </a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" style="border-radius: 12px; border: none; background: #dcfce7; color: #16a34a;">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon" style="background: #dbeafe; color: #1e40af;"><i class="fa-solid fa-cubes"></i></div>
            <div class="stat-info"><h3>@totalInsumos</h3><p>Total Insumos</p></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #fee2e2; color: #dc2626;"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div class="stat-info"><h3>@bajoStock</h3><p>Bajo Stock</p></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #dcfce7; color: #16a34a;"><i class="fa-solid fa-coins"></i></div>
            <div class="stat-info"><h3>₡@valorTotal.ToString("N0")</h3><p>Valor Total</p></div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5" style="border-radius: 16px;">
            <h4>No hay insumos registrados</h4>
            <p class="mb-0">Creá el primer insumo para empezar a controlar el stock.</p>
        </div>
    }
    else
    {
        <div class="tabla-premium">
            <table>
                <thead>
                    <tr>
                        <th>Insumo</th>
                        <th>Unidad</th>
                        <th>Stock Actual</th>
                        <th>Stock Mínimo</th>
                        <th>Costo Unit.</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        var estado = i.StockActual <= i.StockMinimo * 0.5m ? "stock-critico" : i.StockActual <= i.StockMinimo ? "stock-bajo" : "stock-ok";
                        var estadoTexto = i.StockActual <= i.StockMinimo * 0.5m ? "Crítico" : i.StockActual <= i.StockMinimo ? "Bajo" : "OK";
                        <tr>
                            <td><strong>@i.Nombre</strong></td>
                            <td><span class="text-muted">@i.UnidadMedida</span></td>
                            <td><span style="font-weight: 800; color: #1a365d;">@i.StockActual.ToString("N2")</span></td>
                            <td><span style="color: #64748b;">@i.StockMinimo.ToString("N2")</span></td>
                            <td>₡@i.CostoUnitario.ToString("N2")</td>
                            <td><span class="stock-badge @estado">@estadoTexto</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>