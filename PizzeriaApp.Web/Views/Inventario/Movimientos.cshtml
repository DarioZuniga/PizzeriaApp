@model IEnumerable<PizzeriaApp.Data.Entities.MovimientoInventario>
@{ ViewData["Title"] = "Movimientos de Inventario"; }

<style>
    .admin-header {
        background: linear-gradient(135deg, #0f172a 0%, #1a365d 100%);
        border-radius: 24px; padding: 35px; color: white; margin-bottom: 30px;
        position: relative; overflow: hidden;
    }
    .admin-header::before { content: '🔄'; position: absolute; right: -20px; bottom: -40px; font-size: 10rem; opacity: 0.08; }
    .admin-header h1 { font-size: 1.9rem; font-weight: 800; margin: 0; position: relative; }
    .admin-header p { margin: 6px 0 0 0; opacity: 0.85; position: relative; }
    .tabla-premium {
        background: white; border-radius: 20px; overflow: hidden;
        box-shadow: 0 10px 30px rgba(15,23,42,0.08);
    }
    .tabla-premium table { margin: 0; width: 100%; }
    .tabla-premium thead { background: linear-gradient(135deg, #1a365d, #2c5282); color: white; }
    .tabla-premium thead th { padding: 18px 20px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 700; border: none; }
    .tabla-premium tbody td { padding: 18px 20px; border-bottom: 1px solid #e2e8f0; }
    .tipo-badge {
        padding: 6px 14px; border-radius: 50px; font-weight: 700; font-size: 0.75rem;
        text-transform: uppercase; letter-spacing: 0.5px;
    }
    .tipo-entrada { background: #dcfce7; color: #16a34a; }
    .tipo-salida { background: #fee2e2; color: #dc2626; }
    .tipo-merma { background: #fef3c7; color: #d97706; }
    .tipo-ajuste { background: #dbeafe; color: #1e40af; }
    .cantidad-pos { color: #16a34a; font-weight: 800; }
    .cantidad-neg { color: #dc2626; font-weight: 800; }
</style>

<div class="container mt-4">
    <div class="admin-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1><i class="fa-solid fa-arrow-right-arrow-left me-2"></i>Movimientos de Inventario</h1>
                <p>Historial de todas las entradas y salidas de stock</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-light" style="border-radius: 50px; padding: 12px 24px; font-weight: 700;">
                <i class="fa-solid fa-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5" style="border-radius: 16px;">
            <h4>No hay movimientos registrados</h4>
            <p class="mb-0">Los movimientos aparecen automáticamente al registrar compras, mermas o ajustes.</p>
        </div>
    }
    else
    {
        <div class="tabla-premium">
            <table>
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Insumo</th>
                        <th>Tipo</th>
                        <th>Cantidad</th>
                        <th>Costo Unit.</th>
                        <th>Motivo</th>
                        <th>Responsable</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.OrderByDescending(x => x.Fecha))
                    {
                        var tipoClass = m.TipoMovimiento switch
                        {
                            "Entrada" => "tipo-entrada",
                            "Salida" => "tipo-salida",
                            "Merma" => "tipo-merma",
                            _ => "tipo-ajuste"
                        };
                        var cantidadClass = m.TipoMovimiento == "Entrada" ? "cantidad-pos" : "cantidad-neg";
                        <tr>
                            <td><small class="text-muted">@m.Fecha.ToString("dd/MM/yyyy HH:mm")</small></td>
                            <td><strong>@m.Insumo?.Nombre</strong></td>
                            <td><span class="tipo-badge @tipoClass">@m.TipoMovimiento</span></td>
                            <td><span class="@cantidadClass">@(m.TipoMovimiento == "Entrada" ? "+" : "-")@m.Cantidad.ToString("N2")</span></td>
                            <td>₡@m.CostoUnitario.ToString("N2")</td>
                            <td><small class="text-muted">@m.Motivo</small></td>
                            <td><small class="text-muted">@m.UsuarioResponsable</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>