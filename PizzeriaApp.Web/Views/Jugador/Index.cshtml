@model IEnumerable<PizzeriaApp.Data.Entities.Jugador>

@{
    ViewData["Title"] = "Gestión de Jugadores";
    var equipos = ViewBag.Equipos as List<SelectListItem>;
}

@Html.AntiForgeryToken()

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white">
                <i class="fa-solid fa-person-running text-success me-2"></i>
                Gestión de Jugadores
            </h2>
            <p class="text-secondary mb-0">
                Administra jugadores, posición, nacionalidad y equipo asociado.
            </p>
        </div>

        <button class="btn btn-football px-4" data-bs-toggle="modal" data-bs-target="#jugadorModal" onclick="abrirCrearJugador()">
            <i class="fa-solid fa-plus me-2"></i>
            Nuevo Jugador
        </button>
    </div>

    <div class="dashboard-panel">
        <div class="table-responsive">
            <table id="jugadoresTable" class="table table-dark table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th>Nombre</th>
                        <th>Posición</th>
                        <th>Nacionalidad</th>
                        <th>Equipo</th>
                        <th style="width:170px;" class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-id="@item.JugadorId">
                            <td>@item.JugadorId</td>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td>@item.Posicion</td>
                            <td>@item.Nacionalidad</td>
                            <td>@item.Equipo.Nombre</td>
                            <td class="text-center">
                                <button class="btn btn-warning btn-sm" onclick="abrirEditarJugador(@item.JugadorId)">
                                    <i class="fa-solid fa-pen"></i>
                                </button>

                                <button class="btn btn-danger btn-sm" onclick="eliminarJugador(@item.JugadorId, '@item.Nombre')">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="jugadorModal" tabindex="-1" aria-labelledby="jugadorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-social-card border border-social text-white" style="border-radius: 18px;">
            <div class="modal-header border-social">
                <h5 class="modal-title fw-bold" id="jugadorModalLabel">
                    Nuevo Jugador
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="jugadorId" />

                <div class="mb-3">
                    <label class="form-label text-secondary fw-semibold">Equipo</label>
                    <select id="equipoIdJugador" class="form-select bg-dark text-white border-secondary">
                        <option value="">Seleccione un equipo</option>
                        @foreach (var equipo in equipos!)
                        {
                            <option value="@equipo.Value">@equipo.Text</option>
                        }
                    </select>
                    <span id="equipoJugadorError" class="text-warning small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary fw-semibold">Nombre</label>
                    <input type="text" id="nombreJugador" class="form-control bg-dark text-white border-secondary" placeholder="Ej: Lionel Messi" />
                    <span id="nombreJugadorError" class="text-warning small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary fw-semibold">Posición</label>
                    <input type="text" id="posicionJugador" class="form-control bg-dark text-white border-secondary" placeholder="Ej: Delantero" />
                    <span id="posicionJugadorError" class="text-warning small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary fw-semibold">Nacionalidad</label>
                    <input type="text" id="nacionalidadJugador" class="form-control bg-dark text-white border-secondary" placeholder="Ej: Argentina" />
                    <span id="nacionalidadJugadorError" class="text-warning small"></span>
                </div>
            </div>

            <div class="modal-footer border-social">
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button" class="btn btn-football" onclick="guardarJugador()">
                    <i class="fa-solid fa-save me-2"></i>
                    Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let jugadoresTable;

        $(document).ready(function () {
            jugadoresTable = $('#jugadoresTable').DataTable({
                language: {
                    url: "https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json"
                },
                pageLength: 5,
                lengthMenu: [5, 10, 25, 50],
                order: [[1, "asc"]],
                columnDefs: [
                    { orderable: false, targets: 5 }
                ],
                layout: {
                    topStart: {
                        buttons: [
                            {
                                extend: 'excelHtml5',
                                text: '<i class="fa-solid fa-file-excel me-1"></i> Excel',
                                className: 'btn btn-success btn-sm'
                            },
                            {
                                extend: 'pdfHtml5',
                                text: '<i class="fa-solid fa-file-pdf me-1"></i> PDF',
                                className: 'btn btn-danger btn-sm'
                            },
                            {
                                extend: 'print',
                                text: '<i class="fa-solid fa-print me-1"></i> Imprimir',
                                className: 'btn btn-secondary btn-sm'
                            }
                        ]
                    }
                }
            });
        });

        function obtenerToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        function limpiarFormularioJugador() {
            document.getElementById("jugadorId").value = "";
            document.getElementById("equipoIdJugador").value = "";
            document.getElementById("nombreJugador").value = "";
            document.getElementById("posicionJugador").value = "";
            document.getElementById("nacionalidadJugador").value = "";
            limpiarErroresJugador();
        }

        function limpiarErroresJugador() {
            document.getElementById("equipoJugadorError").innerText = "";
            document.getElementById("nombreJugadorError").innerText = "";
            document.getElementById("posicionJugadorError").innerText = "";
            document.getElementById("nacionalidadJugadorError").innerText = "";
        }

        function abrirCrearJugador() {
            limpiarFormularioJugador();
            document.getElementById("jugadorModalLabel").innerText = "Nuevo Jugador";
        }

        async function abrirEditarJugador(id) {
            limpiarFormularioJugador();

            const response = await fetch(`/Jugador/GetById/${id}`);

            if (!response.ok) {
                mostrarError("No se pudo cargar el jugador.");
                return;
            }

            const jugador = await response.json();

            document.getElementById("jugadorId").value = jugador.jugadorId;
            document.getElementById("equipoIdJugador").value = jugador.equipoId;
            document.getElementById("nombreJugador").value = jugador.nombre;
            document.getElementById("posicionJugador").value = jugador.posicion;
            document.getElementById("nacionalidadJugador").value = jugador.nacionalidad;
            document.getElementById("jugadorModalLabel").innerText = "Editar Jugador";

            const modal = new bootstrap.Modal(document.getElementById("jugadorModal"));
            modal.show();
        }

        async function guardarJugador() {
            const id = document.getElementById("jugadorId").value;
            const equipoId = document.getElementById("equipoIdJugador").value;
            const nombre = document.getElementById("nombreJugador").value.trim();
            const posicion = document.getElementById("posicionJugador").value.trim();
            const nacionalidad = document.getElementById("nacionalidadJugador").value.trim();

            limpiarErroresJugador();

            let valido = true;

            if (!equipoId) {
                document.getElementById("equipoJugadorError").innerText = "Debe seleccionar un equipo.";
                valido = false;
            }

            if (!nombre) {
                document.getElementById("nombreJugadorError").innerText = "El nombre es obligatorio.";
                valido = false;
            }

            if (!posicion) {
                document.getElementById("posicionJugadorError").innerText = "La posición es obligatoria.";
                valido = false;
            }

            if (!nacionalidad) {
                document.getElementById("nacionalidadJugadorError").innerText = "La nacionalidad es obligatoria.";
                valido = false;
            }

            if (!valido) {
                return;
            }

            const formData = new FormData();
            formData.append("__RequestVerificationToken", obtenerToken());
            formData.append("EquipoId", equipoId);
            formData.append("Nombre", nombre);
            formData.append("Posicion", posicion);
            formData.append("Nacionalidad", nacionalidad);

            const url = id
                ? `/Jugador/EditAjax/${id}`
                : `/Jugador/CreateAjax`;

            const response = await fetch(url, {
                method: "POST",
                body: formData
            });

            if (!response.ok) {
                mostrarError("No se pudo guardar el jugador.");
                return;
            }

            const result = await response.json();

            if (result.success) {
                Swal.fire({
                    icon: "success",
                    title: "Correcto",
                    text: result.message,
                    timer: 1500,
                    showConfirmButton: false,
                    background: "#16161D",
                    color: "#E4E4E7"
                }).then(() => location.reload());
            }
        }

        function eliminarJugador(id, nombre) {
            Swal.fire({
                title: "¿Eliminar jugador?",
                text: `Se eliminará "${nombre}". Esta acción no se puede deshacer.`,
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#dc3545",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Sí, eliminar",
                cancelButtonText: "Cancelar",
                background: "#16161D",
                color: "#E4E4E7"
            }).then(async (result) => {
                if (!result.isConfirmed) {
                    return;
                }

                const formData = new FormData();
                formData.append("__RequestVerificationToken", obtenerToken());

                const response = await fetch(`/Jugador/DeleteAjax/${id}`, {
                    method: "POST",
                    body: formData
                });

                if (!response.ok) {
                    mostrarError("No se pudo eliminar el jugador.");
                    return;
                }

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: "success",
                        title: "Eliminado",
                        text: data.message,
                        timer: 1500,
                        showConfirmButton: false,
                        background: "#16161D",
                        color: "#E4E4E7"
                    }).then(() => location.reload());
                }
            });
        }

        function mostrarError(mensaje) {
            Swal.fire({
                icon: "error",
                title: "Error",
                text: mensaje,
                background: "#16161D",
                color: "#E4E4E7"
            });
        }
    </script>
}