@model IEnumerable<PizzeriaApp.Data.Entities.Evaluacion>
@{ ViewData["Title"] = "Moderación de Comentarios"; }
<div class="container mt-4">
    <h2 style="color: #1a365d;">⭐ Moderación de Comentarios</h2>
    <hr />
    <div class="row">
        @foreach (var e in Model) {
            <div class="col-md-6 mb-3">
                <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                    <div class="card-body">
                        <h5 class="fw-bold">@(e.Pedido?.Usuario?.NombreUsuario ?? "Cliente")</h5>
                        <p class="text-warning fs-5 mb-1">
                            @for (int i = 0; i < e.Calificacion; i++) { <i class="fa-solid fa-star"></i> }
                            <span class="text-muted fs-6">(@e.Calificacion/10)</span>
                        </p>
                        <p class="text-muted mb-2">@e.Comentario</p>
                        <small class="text-muted">Fecha: @e.Fecha.ToString("dd/MM/yyyy")</small>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any()) {
            <div class="col-12 text-center text-muted py-5">No hay comentarios registrados aún.</div>
        }
    </div>
</div>