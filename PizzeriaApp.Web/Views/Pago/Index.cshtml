@model PizzeriaApp.Data.Entities.Pedido
@{
    ViewData["Title"] = "Pago";
}

<div class="container mt-4">
    <h2 style="color: #1a365d;">💳 Pago del Pedido #@Model.PedidoId</h2>
    <hr />

    <div class="row">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                <div class="card-body">
                    <h4 class="fw-bold">Total a Pagar</h4>
                    <h2 class="text-danger fw-bold">₡@Model.Total.ToString("N2")</h2>
                    <hr />
                    <form asp-action="Procesar" method="post">
                        <input type="hidden" name="pedidoId" value="@Model.PedidoId" />
                        
                        <h5 class="fw-bold mb-3">Seleccione método de pago:</h5>
                        
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="metodoPago" value="Tarjeta" id="tarjeta" checked required />
                            <label class="form-check-label" for="tarjeta">
                                <i class="fa-solid fa-credit-card me-2"></i> Tarjeta de Crédito/Débito (Simulado)
                            </label>
                        </div>
                        
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="metodoPago" value="SINPE" id="sinpe" required />
                            <label class="form-check-label" for="sinpe">
                                <i class="fa-solid fa-mobile-screen me-2"></i> SINPE Móvil (Simulado)
                            </label>
                        </div>
                        
                        <div class="form-check mb-4">
                            <input class="form-check-input" type="radio" name="metodoPago" value="ContraEntrega" id="contra" required />
                            <label class="form-check-label" for="contra">
                                <i class="fa-solid fa-money-bill me-2"></i> Pago Contra Entrega
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg" style="background-color: #1a365d;">
                            Pagar Ahora
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>