@model PizzeriaApp.Data.Entities.Pedido
@{
    ViewData["Title"] = "Seguimiento del Pedido";
}

<div class="container mt-4">
    <h2 style="color: #1a365d;">📦 Pedido #@Model.PedidoId</h2>
    <p class="text-muted">Estado actual: <strong>@Model.Estado</strong></p>
    <hr />
    
    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body">
            <h5 class="fw-bold">Productos</h5>
            <ul class="list-group list-group-flush">
                @foreach (var detalle in Model.Detalles)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@detalle.Cantidad x @detalle.Producto.Nombre</span>
                        <span class="fw-bold">₡@((detalle.PrecioUnitario * detalle.Cantidad).ToString("N2"))</span>
                    </li>
                }
            </ul>
            <hr />
            <div class="d-flex justify-content-between fw-bold fs-5">
                <span>Total:</span>
                <span class="text-danger">₡@Model.Total.ToString("N2")</span>
            </div>
            <a asp-action="Historial" class="btn btn-secondary mt-3">Volver al Historial</a>
        </div>
    </div>
</div>