@model PizzeriaApp.Data.Entities.Producto
@{
    ViewData["Title"] = "Nuevo Producto";
    var categorias = ViewBag.Categorias as List<PizzeriaApp.Data.Entities.Categoria>;
}

<div class="container mt-4">
    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-4">
            <h3 class="mb-4" style="color: #1a365d;">Nuevo Producto</h3>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nombre" class="form-label fw-bold">Nombre</label>
                        <input asp-for="Nombre" class="form-control" required />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoriaId" class="form-label fw-bold">Categoría</label>
                        <select asp-for="CategoriaId" class="form-select" required>
                            <option value="">Seleccione una categoría</option>
                            @if (categorias != null)
                            {
                                foreach (var cat in categorias)
                                {
                                    <option value="@cat.CategoriaId">@cat.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Precio" class="form-label fw-bold">Precio (₡)</label>
                        <input asp-for="Precio" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ImagenUrl" class="form-label fw-bold">URL de Imagen</label>
                        <input asp-for="ImagenUrl" class="form-control" placeholder="https://..." />
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Activo" class="form-check-input" checked />
                    <label asp-for="Activo" class="form-check-label">Activo</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" style="background-color: #1a365d;">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>