@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<PizzeriaApp.Data.Entities.Reporte>

@{
    ViewData["Title"] = "Gestión de Reportes";

    var estados =
        ViewBag.Estados as IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();
}

@Html.AntiForgeryToken()

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-white mb-1">
                <i class="fa-solid fa-triangle-exclamation text-warning me-2"></i>
                Gestión de Reportes
            </h2>

            <p class="text-secondary mb-0">
                Revisa y modera los reportes realizados por los usuarios.
            </p>
        </div>

        <div class="bg-social-card border border-social rounded-3 px-4 py-3">
            <span class="text-secondary">Total de reportes:</span>
            <strong class="text-warning ms-2">@Model.Count()</strong>
        </div>
    </div>

    <div class="dashboard-panel">
        <div class="table-responsive">
            <table id="reportesTable"
                   class="table table-dark table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Usuario</th>
                        <th>Tema</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ReporteId</td>

                            <td>
                                <span class="fw-semibold text-white">
                                    @item.Usuario.NombreUsuario
                                </span>
                            </td>

                            <td>
                                <span class="text-info">
                                    @item.Tema.Titulo
                                </span>
                            </td>

                            <td>
                                <span title="@item.Motivo">
                                    @(item.Motivo.Length > 70
                                        ? item.Motivo[..70] + "..."
                                        : item.Motivo)
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-warning text-dark px-3 py-2">
                                    @item.Estado.Nombre
                                </span>
                            </td>

                            <td data-order="@item.FechaReporte.ToString("yyyy-MM-dd HH:mm:ss")">
                                @item.FechaReporte.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td class="text-center">
                                <button type="button"
                                        class="btn btn-warning btn-sm"
                                        title="Cambiar estado"
                                        onclick="abrirCambiarEstado(@item.ReporteId)">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>

                                <button type="button"
                                        class="btn btn-info btn-sm"
                                        title="Ver motivo completo"
                                        onclick='verDetalleReporte(
                                            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Usuario.NombreUsuario)),
                                            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Tema.Titulo)),
                                            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Motivo)),
                                            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Estado.Nombre)),
                                            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.FechaReporte.ToString("dd/MM/yyyy HH:mm")))
                                        )'>
                                    <i class="fa-solid fa-eye"></i>
                                </button>

                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        title="Eliminar"
                                        onclick="eliminarReporte(@item.ReporteId)">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade"
     id="estadoReporteModal"
     tabindex="-1"
     aria-labelledby="estadoReporteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-social-card border border-social text-white"
             style="border-radius: 18px;">

            <div class="modal-header border-social">
                <h5 class="modal-title fw-bold"
                    id="estadoReporteModalLabel">

                    <i class="fa-solid fa-shield-halved text-warning me-2"></i>
                    Cambiar estado del reporte
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="reporteId" />

                <div class="mb-3">
                    <label for="estadoId"
                           class="form-label text-secondary fw-semibold">
                        Estado
                    </label>

                    <select id="estadoId"
                            class="form-select bg-dark text-white border-secondary">

                        <option value="">Seleccione un estado</option>

                        @foreach (var estado in estados)
                        {
                            <option value="@estado.Value">
                                @estado.Text
                            </option>
                        }
                    </select>

                    <span id="estadoError"
                          class="text-warning small">
                    </span>
                </div>
            </div>

            <div class="modal-footer border-social">
                <button type="button"
                        class="btn btn-outline-light"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-football"
                        onclick="guardarEstadoReporte()">

                    <i class="fa-solid fa-floppy-disk me-2"></i>
                    Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let reportesTable;

        $(document).ready(function () {
            reportesTable = $('#reportesTable').DataTable({
                language: {
                    url: "https://cdn.datatables.net/plug-ins/2.0.8/i18n/es-ES.json"
                },
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                order: [[5, "desc"]],
                columnDefs: [
                    {
                        orderable: false,
                        targets: 6
                    }
                ],
                layout: {
                    topStart: {
                        buttons: [
                            {
                                extend: "excelHtml5",
                                text: '<i class="fa-solid fa-file-excel me-1"></i> Excel',
                                className: "btn btn-success btn-sm",
                                exportOptions: {
                                    columns: [0, 1, 2, 3, 4, 5]
                                }
                            },
                            {
                                extend: "pdfHtml5",
                                text: '<i class="fa-solid fa-file-pdf me-1"></i> PDF',
                                className: "btn btn-danger btn-sm",
                                orientation: "landscape",
                                pageSize: "A4",
                                exportOptions: {
                                    columns: [0, 1, 2, 3, 4, 5]
                                }
                            },
                            {
                                extend: "print",
                                text: '<i class="fa-solid fa-print me-1"></i> Imprimir',
                                className: "btn btn-secondary btn-sm",
                                exportOptions: {
                                    columns: [0, 1, 2, 3, 4, 5]
                                }
                            }
                        ]
                    }
                }
            });
        });

        function obtenerToken() {
            return document.querySelector(
                'input[name="__RequestVerificationToken"]'
            ).value;
        }

        async function abrirCambiarEstado(id) {
            document.getElementById("reporteId").value = "";
            document.getElementById("estadoId").value = "";
            document.getElementById("estadoError").innerText = "";

            try {
                const response = await fetch(
                    `/Reporte/GetById?id=${id}`
                );

                if (!response.ok) {
                    const error = await obtenerRespuestaError(response);
                    mostrarError(error);
                    return;
                }

                const reporte = await response.json();

                document.getElementById("reporteId").value =
                    reporte.reporteId;

                document.getElementById("estadoId").value =
                    reporte.estadoId;

                const modal = bootstrap.Modal.getOrCreateInstance(
                    document.getElementById("estadoReporteModal")
                );

                modal.show();
            } catch {
                mostrarError(
                    "Ocurrió un error al cargar el reporte."
                );
            }
        }

        async function guardarEstadoReporte() {
            const reporteId =
                document.getElementById("reporteId").value;

            const estadoId =
                document.getElementById("estadoId").value;

            document.getElementById("estadoError").innerText = "";

            if (!estadoId) {
                document.getElementById("estadoError").innerText =
                    "Debe seleccionar un estado.";

                return;
            }

            const formData = new FormData();

            formData.append(
                "__RequestVerificationToken",
                obtenerToken()
            );

            formData.append("ReporteId", reporteId);
            formData.append("EstadoId", estadoId);

            try {
                const response = await fetch(
                    "/Reporte/CambiarEstadoAjax",
                    {
                        method: "POST",
                        body: formData
                    }
                );

                if (!response.ok) {
                    const error = await obtenerRespuestaError(response);
                    mostrarError(error);
                    return;
                }

                const result = await response.json();

                await Swal.fire({
                    icon: "success",
                    title: "Estado actualizado",
                    text: result.message,
                    timer: 1600,
                    showConfirmButton: false,
                    background: "#16161D",
                    color: "#E4E4E7"
                });

                location.reload();
            } catch {
                mostrarError(
                    "Ocurrió un error al actualizar el reporte."
                );
            }
        }

        function verDetalleReporte(
            usuario,
            tema,
            motivo,
            estado,
            fecha
        ) {
            Swal.fire({
                title: "Detalle del reporte",
                html: `
                    <div class="text-start">
                        <p>
                            <strong>Usuario:</strong><br>
                            ${escaparHtml(usuario)}
                        </p>

                        <p>
                            <strong>Tema:</strong><br>
                            ${escaparHtml(tema)}
                        </p>

                        <p>
                            <strong>Estado:</strong><br>
                            ${escaparHtml(estado)}
                        </p>

                        <p>
                            <strong>Fecha:</strong><br>
                            ${escaparHtml(fecha)}
                        </p>

                        <p class="mb-0">
                            <strong>Motivo:</strong><br>
                            ${escaparHtml(motivo)}
                        </p>
                    </div>
                `,
                icon: "info",
                confirmButtonText: "Cerrar",
                background: "#16161D",
                color: "#E4E4E7"
            });
        }

        function eliminarReporte(id) {
            Swal.fire({
                title: "¿Eliminar reporte?",
                text: "Esta acción no se puede deshacer.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#dc3545",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Sí, eliminar",
                cancelButtonText: "Cancelar",
                background: "#16161D",
                color: "#E4E4E7"
            }).then(async result => {
                if (!result.isConfirmed) {
                    return;
                }

                const formData = new FormData();

                formData.append(
                    "__RequestVerificationToken",
                    obtenerToken()
                );

                try {
                    const response = await fetch(
                        `/Reporte/DeleteAjax?id=${id}`,
                        {
                            method: "POST",
                            body: formData
                        }
                    );

                    if (!response.ok) {
                        const error =
                            await obtenerRespuestaError(response);

                        mostrarError(error);
                        return;
                    }

                    const data = await response.json();

                    await Swal.fire({
                        icon: "success",
                        title: "Reporte eliminado",
                        text: data.message,
                        timer: 1600,
                        showConfirmButton: false,
                        background: "#16161D",
                        color: "#E4E4E7"
                    });

                    location.reload();
                } catch {
                    mostrarError(
                        "Ocurrió un error al eliminar el reporte."
                    );
                }
            });
        }

        async function obtenerRespuestaError(response) {
            try {
                const data = await response.json();

                return data.message
                    ?? "No se pudo completar la operación.";
            } catch {
                return "No se pudo completar la operación.";
            }
        }

        function escaparHtml(valor) {
            const elemento = document.createElement("div");
            elemento.textContent = valor ?? "";
            return elemento.innerHTML;
        }

        function mostrarError(mensaje) {
            Swal.fire({
                icon: "error",
                title: "Error",
                text: mensaje,
                background: "#16161D",
                color: "#E4E4E7"
            });
        }
    </script>
}