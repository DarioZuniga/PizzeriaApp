@model IEnumerable<PizzeriaApp.Data.Entities.Reserva>
@{
    ViewData["Title"] = "Gestión de Reservas";
}

<div class="container mt-4">
    <h2 style="color: #1a365d;">📋 Gestión de Reservas</h2>
    <hr />
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Fecha y Hora</th>
                <th>Personas</th>
                <th>Estado</th>
                <th>Notas</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Usuario?.NombreUsuario</td>
                    <td>@r.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@r.CantidadPersonas</td>
                    <td>
                        @if (r.Estado == "Confirmada") { <span class="badge bg-success">Confirmada</span> }
                        else if (r.Estado == "Cancelada") { <span class="badge bg-danger">Cancelada</span> }
                        else { <span class="badge bg-warning text-dark">Pendiente</span> }
                    </td>
                    <td>@r.Notas</td>
                </tr>
            }
        </tbody>
    </table>
</div>