@model IEnumerable<PizzeriaApp.Data.Entities.Reserva>

@{
    ViewData["Title"] = "Mis Reservas";
}

<div class="container mt-4">
    <h2 style="color: #1a365d;">Mis Reservas</h2>
    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Fecha y Hora</th>
                    <th>Personas</th>
                    <th>Estado</th>
                    <th>Notas</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            @r.FechaHora.ToString("dd/MM/yyyy HH:mm")
                            <br />
                            <small class="text-muted">
                                Código: <strong>@r.CodigoConfirmacion</strong>
                            </small>
                        </td>

                        <td>@r.CantidadPersonas</td>

                        <td>
                            @if (r.Estado == "Confirmada")
                            {
                                <span class="badge bg-success">Confirmada</span>
                            }
                            else if (r.Estado == "Rechazada")
                            {
                                <span class="badge bg-danger">Rechazada</span>
                            }
                            else if (r.Estado == "Cancelada")
                            {
                                <span class="badge bg-secondary">Cancelada</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pendiente</span>
                            }
                        </td>

                        <td>@r.Notas</td>

                        <td>
                            @if (r.Estado == "Pendiente")
                            {
                                <a asp-action="Editar"
                                   asp-route-id="@r.ReservaId"
                                   class="btn btn-sm btn-outline-primary">
                                    Editar
                                </a>

                                <form asp-action="Cancelar"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('¿Deseas cancelar esta reserva?');">

                                    <input type="hidden"
                                           name="id"
                                           value="@r.ReservaId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Cancelar
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">Sin acciones</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
