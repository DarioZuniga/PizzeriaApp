<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Las Perlas</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --lp-dark: #0f172a;
            --lp-gold: #d4af37;
            --lp-light: #f8fafc;
            --lp-text: #334155;
        }
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--lp-light);
            color: var(--lp-text);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        h1, h2, h3, h4, h5, h6, .navbar-brand {
            font-family: 'Playfair Display', serif;
            color: var(--lp-dark);
        }
        .navbar {
            background: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            padding: 1rem 0;
            transition: all 0.3s ease;
        }
        .navbar-brand {
            font-weight: 600;
            font-size: 1.8rem;
            color: var(--lp-dark) !important;
            letter-spacing: 1px;
        }
        .nav-link {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--lp-dark) !important;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 0 5px;
            position: relative;
        }
        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 0;
            background-color: var(--lp-gold);
            transition: width 0.3s;
        }
        .nav-link:hover::after {
            width: 100%;
        }
        .btn-lp-primary {
            background-color: var(--lp-dark);
            color: white;
            font-weight: 600;
            border-radius: 50px;
            padding: 10px 25px;
            border: none;
            transition: all 0.3s;
        }
        .btn-lp-primary:hover {
            background-color: var(--lp-gold);
            color: var(--lp-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(212, 175, 55, 0.3);
        }
        .btn-lp-outline {
            border: 2px solid var(--lp-dark);
            color: var(--lp-dark);
            font-weight: 600;
            border-radius: 50px;
            padding: 10px 25px;
            background: transparent;
            transition: all 0.3s;
        }
        .btn-lp-outline:hover {
            background-color: var(--lp-dark);
            color: white;
        }
        .footer {
            background-color: var(--lp-dark);
            color: #94a3b8;
            padding: 3rem 0;
            margin-top: auto;
        }
        .footer h4 {
            color: white;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/favicon.png" alt="Logo" style="height: 40px; margin-right: 10px;" /> Las Perlas
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-4">
                        
                        <!-- OPCIONES DE CLIENTE -->
                        @if (!User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Menú</a>
                            </li>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Pedido" asp-action="Historial">Mis Pedidos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Reserva" asp-action="MisReservas">Reservas</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Perfil" asp-action="Index">Mi Perfil</a></li>
                            }
                        }

                        <!-- OPCIONES DE ADMINISTRADOR -->
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Producto" asp-action="Index">Productos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Pedido" asp-action="Gestion">Pedidos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Inventario" asp-action="Index">Inventario</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Usuario" asp-action="Index">Usuarios</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reporte" asp-action="Index">Reportes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Evento" asp-action="Index">Eventos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Cupon" asp-action="Index">Cupones</a></li>
                        }
                    </ul>
                    
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Carrito solo para clientes -->
                            @if (!User.IsInRole("Administrador"))
                            {
                                <li class="nav-item me-3">
                                    <a class="nav-link position-relative" asp-controller="Carrito" asp-action="Index">
                                        <i class="fa-solid fa-bag-shopping fa-lg"></i>
                                    </a>
                                </li>
                            }
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-user-astronaut me-1"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-3">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Cerrar Sesión</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2"><a class="btn btn-lp-outline btn-sm" asp-controller="Account" asp-action="Login">Iniciar Sesión</a></li>
                            <li class="nav-item"><a class="btn btn-lp-primary btn-sm" asp-controller="Account" asp-action="Register">Registrarse</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container mt-4 flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container text-center">
            <h4 class="mb-3"><img src="~/favicon.png" alt="Logo" style="height: 30px; margin-right: 10px; filter: brightness(0) invert(1);" /> Las Perlas</h4>
            <p class="mb-1">La experiencia gastronómica que mereces.</p>
            <p class="mb-0 text-muted" style="font-size: 0.9rem;">&copy; 2026 PizzeriaApp - Pizzería Las Perlas.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>